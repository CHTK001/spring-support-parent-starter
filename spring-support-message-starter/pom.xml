<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support Message Starter - 消息推送集成模块

    这是Spring Support框架的消息推送模块，提供统一的消息推送解决方案。
    主要特性包括：

    1. 多渠道支持 - 钉钉、飞书、邮件、短信等
    2. 消息提供商 - 数据库表驱动管理各消息服务商配置
    3. 消息模板 - 数据库表驱动管理各渠道消息模板
    4. 统一发送 - 通过MessagePush SPI实现统一消息发送
    5. 自动建表 - 适配datasource-starter自动执行db/init下的建表脚本

    @author CH
    @version 4.0.0.42
-->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父项目配置 -->
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
        
    </parent>

    <!-- 项目基本信息 -->
    <artifactId>spring-support-message-starter</artifactId>
    <description>Spring Support框架消息推送模块，提供消息提供商、消息模板管理及统一消息推送功能</description>

    <!-- 项目属性配置 -->

<!-- 依赖配置 -->
    <dependencies>
        <!-- 通用功能模块 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- MyBatis Plus 基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 消息模板 → 统一模板库（消息模板同时接入 template_info） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-template-starter</artifactId>
            <version>4.0.0.51</version>
        </dependency>

        <!-- Socket 会话模板（站内消息渠道推送） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
        </dependency>

        <!-- OAuth 客户端权限注解 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
        </dependency>

        <!-- Swagger 注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- 各渠道实现为可选依赖
        用户根据需要在自己的项目中添加对应的渠道依赖：
        - utils-support-dingding-starter   钉钉机器人
        - utils-support-feishu-starter     飞书消息
        - utils-support-alibaba-starter    阿里云短信
        - utils-support-tencent-starter    腾讯微信公众号
        - utils-support-email-starter      邮件
        -->
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>

                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

