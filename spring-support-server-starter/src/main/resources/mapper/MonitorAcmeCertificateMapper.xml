<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.server.support.acme.mapper.MonitorAcmeCertificateMapper">

    <resultMap id="BaseResultMap" type="com.chua.starter.server.support.acme.entity.MonitorAcmeCertificate">
        <id column="acme_cert_id" property="acmeCertId" jdbcType="INTEGER"/>
        <result column="acme_account_id" property="acmeAccountId" jdbcType="INTEGER"/>
        <result column="acme_cert_primary_domain" property="acmeCertPrimaryDomain" jdbcType="VARCHAR"/>
        <result column="acme_cert_san" property="acmeCertSan" jdbcType="VARCHAR"/>
        <result column="acme_cert_challenge_type" property="acmeCertChallengeType" jdbcType="VARCHAR"/>
        <result column="acme_cert_status" property="acmeCertStatus" jdbcType="VARCHAR"/>
        <result column="acme_cert_not_before" property="acmeCertNotBefore" jdbcType="VARCHAR"/>
        <result column="acme_cert_not_after" property="acmeCertNotAfter" jdbcType="VARCHAR"/>
        <result column="acme_cert_renew_at" property="acmeCertRenewAt" jdbcType="VARCHAR"/>
        <result column="acme_cert_chain_pem" property="acmeCertChainPem" jdbcType="LONGVARCHAR"/>
        <result column="acme_cert_key_pem" property="acmeCertKeyPem" jdbcType="LONGVARCHAR"/>
        <result column="acme_cert_last_error" property="acmeCertLastError" jdbcType="VARCHAR"/>
        <result column="acme_cert_deploy_mode" property="acmeCertDeployMode" jdbcType="VARCHAR"/>
        <result column="acme_cert_webroot_path" property="acmeCertWebrootPath" jdbcType="VARCHAR"/>
        <result column="create_name" property="createName" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_name" property="updateName" jdbcType="VARCHAR"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        acme_cert_id, acme_account_id, acme_cert_primary_domain, acme_cert_san,
        acme_cert_challenge_type, acme_cert_status, acme_cert_not_before, acme_cert_not_after,
        acme_cert_renew_at, acme_cert_chain_pem, acme_cert_key_pem, acme_cert_last_error,
        acme_cert_deploy_mode, acme_cert_webroot_path,
        create_name, create_time, update_name, update_time, create_by, update_by
    </sql>

    <select id="selectByPrimaryDomain" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM monitor_acme_certificate
        WHERE acme_cert_primary_domain = #{primaryDomain}
        ORDER BY update_time DESC
    </select>
</mapper>
