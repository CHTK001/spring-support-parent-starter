<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>
    <artifactId>spring-support-server-starter</artifactId>
    <description>
        服务器资产模块：提供主机台账、分组、密钥库、登录身份等资产管理，基于 Guacamole(guacd)
        的 SSH/SFTP/RDP/VNC 远程控制 WebSocket 网关，以及批量命令执行、文件分发与 cron 计划任务。
    </description>


    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <!-- 自动配置内核：条件装配与属性绑定 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Web MVC 契约（REST 端点、Controller 类型）：容器由部署壳提供，本模块不携带 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc</artifactId>
        </dependency>
        <!-- WebSocket 支持（远程终端与文件传输） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 串口终端：SerialWebSocketHandler 等直接使用 SerialPort，缺依赖整模块编译不过 -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <!-- MyBatis-Plus 映射与分页（服务节点与操作日志表） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 主机运行时控制器与服务使用 Reactor 异步返回，依赖由根 POM 统一管理 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- 本机硬件/操作系统采集：OSHI 与 JNA 原生桥由 server 直接声明 -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>
        <!-- JNA 核心：OSHI 访问 Windows 系统信息 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <!-- JNA 平台映射：进程、服务与网络接口原生结构 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
        </dependency>

        <!-- 数据库驱动（本地直跑/便携部署）：MySQL + H2 双驱动，缺一报 ClassNotFound -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文件存储：主机文件页直接复用 FileStorageTemplate（分片上传与进度 SSE 也在该模块） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-filesystem-starter</artifactId>
        </dependency>
        <!--
          AI 能力：optional。发布模块只依赖 ReleaseAiCapability 这个门面，
          宿主装了 ai-starter 才装配实现，没装时 AI 入口自动隐藏。
          硬依赖会把 onnx / pty4j 等一整套拖进只用发布模块的应用。
        -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-guacamole-starter</artifactId>
        </dependency>
        <!-- SSH 客户端（JSch）：远程命令与文件分发 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>
        <!-- WinRM：Windows 主机命令执行 / 硬件采集（与 SSH 并存，按系统类型路由） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-winrm-starter</artifactId>
        </dependency>
        <!-- 邮件客户端：邮箱台账与 IMAP 收件 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-email-starter</artifactId>
        </dependency>
        <!-- SSE 传输实现：服务端事件流推送 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-sse-starter</artifactId>
        </dependency>
        <!-- 实时推送契约：SocketSessionTemplate 会话推送 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
        </dependency>
        <!-- Socket.IO 传输实现（netty-socketio 服务端） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-io-starter</artifactId>
        </dependency>
        <!-- 服务管理 ROOM 节点直接使用 RoomServer/RoomProperties，必须由 server 自带该实现 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-websocket-starter</artifactId>
        </dependency>
        <!-- 服务发现查询控制器直接消费 DiscoveryService，能力与依赖同进退 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-discovery-starter</artifactId>
        </dependency>
        <!-- ACME 协议客户端：证书申请与续签 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-acme-starter</artifactId>
        </dependency>
        <!-- 公共数据查询：天气 / 节假日 / 汇率 / IP / 位置 / 台风 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasearch-starter</artifactId>
        </dependency>

        <!-- Git 自动发布 / Git 仓库面板：GitClient（clone/pull/分支/日志/状态） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-git-starter</artifactId>
        </dependency>
        <!-- MavenClient：Git 发布时本地构建 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-maven-starter</artifactId>
        </dependency>

        <!-- 定时发布 / Git 定时轮询：job-starter 为可选依赖，宿主引入后
             ReleaseScheduleServiceImpl 才装配（@ConditionalOnClass） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 远控协议网关：Apache Guacamole 客户端库（对接 guacd 守护进程） -->
        <dependency>
            <groupId>org.apache.guacamole</groupId>
            <artifactId>guacamole-common</artifactId>
        </dependency>

        <!-- RDP 直连原生桥：只依赖 utils 侧 SPI 契约（utils-support-common-starter 的 nativeapi 包），
             具体实现（rdpj.dll + JNA）由部署时按需加入 utils-support-native-rdp。
             这样没有 native 制品也能编译，运行期由 RdpjNative.exists() 探测，
             缺失时直连直接提示“不支持”。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        

        
        
             
             

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 本仓约定非 example 模块不新增 *Test 类，回归脚本以 *Probe 承载。
                         但 surefire 默认只按文件名匹配 Test*/*Test/*Tests/*TestCase，
                         *Probe 类即使带 @Test 注解也永远不会被发现（表现为构建全绿、
                         却没有任何 Tests run 输出）。此处补上 Probe 模式；
                         注意声明 includes 会整体替换默认值，故四种默认模式必须一并保留。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Probe.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 作为内部 starter 库被其它模块依赖：禁用 fat-jar repackage，保留 BOOT-INF 之前的原始 jar 结构，避免下游模块无法解析 com.chua.starter.server.support.* 类 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
