<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>
    <artifactId>spring-support-server-starter</artifactId>
    <description>
        服务器资产模块：提供主机台账、分组、密钥库、登录身份等资产管理，基于 Guacamole(guacd)
        的 SSH/SFTP/RDP/VNC 远程控制 WebSocket 网关，以及批量命令执行、文件分发与 cron 计划任务。
    </description>

    <properties>
        <guacamole.version>1.6.0</guacamole.version>
        <!-- RDP 直连原生桥的 JNA 绑定版本，与本地仓库已缓存版本一致 -->
        <jna.version>5.14.0</jna.version>
        <!-- native 制品版本独立于 utils.version，跟随 utils-support-native-parent 主线 -->
        <native.rdp.version>4.0.0.43</native.rdp.version>
        <!-- 串口终端依赖 -->
        <jserialcomm.version>2.11.0</jserialcomm.version>
    </properties>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- 串口终端：SerialWebSocketHandler 等直接使用 SerialPort，缺依赖整模块编译不过 -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 数据库驱动（本地直跑/便携部署）：MySQL + H2 双驱动，缺一报 ClassNotFound -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-nmap-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-guacamole-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>
        <!-- WinRM：Windows 主机命令执行 / 硬件采集（与 SSH 并存，按系统类型路由） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-winrm-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-email-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-sse-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasearch-starter</artifactId>
        </dependency>

        <!-- Git 自动发布 / Git 仓库面板：GitClient（clone/pull/分支/日志/状态） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-git-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <!-- MavenClient：Git 发布时本地构建 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-maven-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 定时发布 / Git 定时轮询：job-starter 为可选依赖，宿主引入后
             ReleaseScheduleServiceImpl 才装配（@ConditionalOnClass） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 远控协议网关：Apache Guacamole 客户端库（对接 guacd 守护进程） -->
        <dependency>
            <groupId>org.apache.guacamole</groupId>
            <artifactId>guacamole-common</artifactId>
            <version>${guacamole.version}</version>
        </dependency>

        <!-- RDP 直连原生桥：JNA 绑定 rdpj.dll（FreeRDP 3.x 静态链接的 C 扩展）。
             原生库与桥接类由 utils-support-native-rdp 统一提供，本模块只消费，
             不再自带 native/rdpj 资源与 com.chua.nativerdp.support.RdpjBridge 副本。
             native 制品版本独立于 utils.version（native 父 POM 为 4.0.0.43）。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-native-rdp</artifactId>
            <version>${native.rdp.version}</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>${jna.version}</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <!-- JUnit Jupiter：发布脚本生成回归探针 ReleaseScriptProbe 以 @Test 承载，
             使改动 ProjectScripts / 平台 Provider 时能由 mvn test 直接拦住，
             不再依赖只能手工执行的 main() 运行器。与 monitor-starter 保持同源依赖。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 本仓约定非 example 模块不新增 *Test 类，回归脚本以 *Probe 承载。
                         但 surefire 默认只按文件名匹配 Test*/*Test/*Tests/*TestCase，
                         *Probe 类即使带 @Test 注解也永远不会被发现（表现为构建全绿、
                         却没有任何 Tests run 输出）。此处补上 Probe 模式；
                         注意声明 includes 会整体替换默认值，故四种默认模式必须一并保留。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Probe.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 作为内部 starter 库被其它模块依赖：禁用 fat-jar repackage，保留 BOOT-INF 之前的原始 jar 结构，避免下游模块无法解析 com.chua.starter.server.support.* 类 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
