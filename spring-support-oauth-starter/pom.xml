<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
                <version>4.0.0.51</version>
    </parent>

    <artifactId>spring-support-oauth-starter</artifactId>
    <description>单点登录客户端</description>
    <version>4.0.0.51</version>

<dependencies>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- 服务发现：认证服务端地址可写成 discovery://<服务名> / 裸服务名，按发现中心解析实例；
             未装配发现能力时 DiscoveryService 为默认实现、解析不到即回落静态地址 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-discovery-starter</artifactId>
        </dependency>

        <!-- 缓存功能模块 - 提供 CacheProvider 认证信息缓存抽象 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-cache-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.konghq</groupId>
            <artifactId>unirest-java</artifactId>

        </dependency>

        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- appKey 台账查询已改为依赖 spring-support-common-starter 的 AppKeyAuthenticator 契约，
             AI 模块提供实现；本模块不再需要数据源引擎（JdbcEngine）也不直连 AI 的持久层。 -->

        <dependency>
            <groupId>me.zhyd.oauth</groupId>
            <artifactId>JustAuth</artifactId>
            
        </dependency>

        <!-- Armeria 协议已整体移除（2026-09-29）。
             原 ArmeriaProtocol 直接 import com.linecorp.armeria.*，是本模块唯一的直接 armeria 依赖，
             也是 utils 父 pom 里 armeria 版本号（现 1.41.1，本地仓库无此版本）唯一被真正解析的地方。
             删掉它以后本模块不再需要 armeria，也不再传递 armeria + netty-all (~30MB)。
             注意：服务端 spring-api-support-oauth-starter 侧的 armeria 尚未处理，
             那里已不依赖 utils-support-protocol-starter（该模块已删除），与本模块无关。 -->

        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-rsocket-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>


        <!-- HTTP客户端工具 - 提供 HTTP 相关功能 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-httpclient-starter</artifactId>
        </dependency>

        <!-- Spring框架扩展工具 - 提供Spring相关的工具类 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-spring-starter</artifactId>
        </dependency>

        
             
             

    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED</arg>
                        <arg>-parameters</arg>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
