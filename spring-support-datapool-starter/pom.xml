<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>
    <artifactId>spring-support-datapool-starter</artifactId>
    <description>
        数据源中心模块：统一登记与管理被采集/被连接的数据源（JDBC/Redis/InfluxDB/Neo4j/Nacos/ZooKeeper/Nginx 等），
        提供数据源台账 CRUD、连通性探测与可复用的 JDBC 连接（空闲 TTL 缓存 + 跨方言元数据）。
        独立于监控模块，供监控、采集等系统共享。
    </description>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <!--
            租户库连接口：租户模块（tenant-starter）只定义 TenantDatasourceLookup 这个窄接口，
            由本模块的 DatasourceTenantLookupAdapter 在装了台账的应用里补上实现。
            optional=true：本模块单独使用时不强制引入 tenant-starter；
            依赖方向仍是「hub → tenant 的契约」，不会让 tenant-starter 反过来依赖整个数据源中心。
        -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-api-support-common-tenant-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据访问：应用主数据源 + MyBatis-Plus -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <!-- Calcite 联邦内核（数据源合并的编译前提）：datasource-starter 里声明为
             optional，传递不到本模块；合并功能是本模块的一等能力，故显式引入。
             未引时 CalciteMergeDataSourceFactory 编译不过，这属于「功能与依赖同进退」。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-calcite-starter</artifactId>
        </dependency>
        <!-- 中间件 SPI 契约（MiddlewareClientProvider / Capability / VO）与
             DocumentParser("database") 均来自 utils-support-datasource-starter：
             它已由上面的 spring-support-datasource-starter 以 compile 作用域传递带入，
             不再重复声明（重复声明会让同一能力出现两条依赖路径，见 R7）。
             宿主只认契约，不认具体中间件客户端 —— Kafka / InfluxDB / ZooKeeper
             等实现放在各自 utils-support-*-starter 里，按需引入或 OSGi 后装。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具：ReturnResult / SqlName / ExpireValue -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- AI 文本生成 SQL（text2sql）：optional —— 只有宿主应用同时引入 ai-starter 时
             该能力才生效；未引入时 ObjectProvider 取不到实现，ai/status 端点如实上报
             「不可用」，前端据隐藏 text2sql 入口（不会因缺包而启动失败）。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 数据库文档导出（/ms/monitor/db/document/export）：
             结构采集用 utils-support-datasource-starter 里的 DocumentParser("database")，
             markdown / html 渲染器在 utils-support-common-starter 里（已由上面两个依赖带入）。
             word / pdf 渲染器分属独立模块，且 pdf 还要求服务端装 wkhtmltopdf，
             故与 ai-starter 同口径声明为 optional：宿主不引就没有这两个导出格式，
             端点会如实 501、前端据 /document/formats 隐藏入口，而不是给一个点了就报错的按钮。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-word-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-pdf-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SSH 隧道（高级配置）：复用 utils 层已有的 MINA SSHD 客户端，
             其 SshTunnel 已支持 LOCAL/REMOTE(-R 反向)/DYNAMIC(SOCKS5)，
             故本模块不再单独引入任何 SSH 第三方依赖 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>

        <!-- 数据库驱动（本地直跑/便携部署）：MySQL + H2 双驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文件库只随包带 H2；SQLite/DuckDB/ClickHouse 驱动走 JDBC 驱动 jar 上传端点按需安装 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ZooKeeper / MongoDB / SkyWalking 管理面实现按需安装（utils-support-*-starter 或 OSGi 能力包），本模块只依赖 SPI 契约。 -->

        <!-- 数据同步：复用 utils 层已有的 DataSyncEngine / JdbcSyncSource / SyncMapping -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasync-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <!-- 数据同步 FILE/DIR 源：Excel(.xlsx/.xls) 读取依赖 Apache POI -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>
        <!-- 数据同步 HTTP_HTML 源：HTML 表格/CSS 选择器解析依赖 Jsoup -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <!-- 仅测试作用域。规约要求测试必须真实，禁止引入 mockito/easymock/jmock（任何作用域） -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>