<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
  </parent>
  <artifactId>spring-support-collect-starter</artifactId>
  <description>采集调度一体化平台（可视化流程编排 + 复用调度平台作业台账）</description>
  <properties>
    <!-- 结果全文检索（collect_record）使用的 Lucene 版本 -->
    <lucene.version>9.12.2</lucene.version>
  </properties>
  <dependencies>
    <!-- 只消费底层数据管线契约与宿主已有 DatalakeServer，不引入数据中台管理业务。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-datalake-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- 消息投递契约由公共层提供；collect 不依赖 API system 的消息中心实现。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-mybatis-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasource-starter</artifactId>
    </dependency>
    <!-- 数据源中心：SQL/入库节点统一从这里取数据源台账，不再自建 collect_datasource 台账 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datapool-starter</artifactId>
      <version>${module.version}</version>
    </dependency>
    <!-- 勿引入 spring-support-datasource-hub-starter：datapool 由 datasource-hub
         改名而来，旧 hub jar 自带 com.chua.starter.datasourcehub.* 旧控制器，
         与 datapool 新控制器同映射 /ms/datasource，后注册者会被遮蔽或引发
         映射冲突（真实事故：shared-collect 端点 404、list 不过滤）。 -->
      <dependency>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-job-starter</artifactId>
        <!--
          可选依赖：采集本体不依赖调度器。

          排期能力收口在 com.chua.starter.collect.schedule.CollectFlowSchedulePort：
          消费方引入 job-starter 时由 JobFlowSchedulePort 落到 sys_job 台账（行为不变）；
          不引入时由 LocalOnlyFlowSchedulePort 兜底——流程照常设计、手动执行、看结果，
          只是没有定时触发，启用排期会给出明确提示。

          所以这里必须 optional，否则"只想要采集能力"的模块会被动继承整套调度引擎
          （Leader 选举、sys_job_cluster、/v2/job 治理接口及其建表）。
          需要定时的消费方显式声明 job-starter 依赖即可（本仓库的
          spring-api-support-collect-scheduler-starter 就是这么做的）。
        -->
        <optional>true</optional>
      </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-crawler-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- 脚本任务引擎：提供 common-starter ScriptProvider SPI 的 groovy 实现（ScriptFlow） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-groovy-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- JDBC 驱动自动解析（JdbcDriverUtils）来自 utils-support-datasource-starter，
         它已由上面的 spring-support-datasource-starter 以 compile 作用域传递带入，
         不再重复声明（R7：同一 POM 不得同时声明两者）。 -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.24.1</version>
    </dependency>
    <!-- 接口文档注解（@Tag / @Operation / @Schema）：统一由 swagger-starter 以 provided 提供，不进运行时 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-swagger-starter</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- collect_record 全文检索：Lucene 内嵌倒排索引（索引随落库同步更新） -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queryparser</artifactId>
      <version>${lucene.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
      <version>${lucene.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
