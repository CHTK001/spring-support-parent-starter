<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
  </parent>
  <artifactId>spring-support-collect-starter</artifactId>
  <description>采集调度一体化平台（可视化流程编排 + 复用调度平台作业台账）</description>
  <dependencies>
    <!-- 只消费底层数据管线契约与宿主已有 DatalakeServer，不引入数据中台管理业务 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-datalake-starter</artifactId>
    </dependency>
    <!-- 消息投递契约由公共层提供；collect 不依赖 API system 的消息中心实现 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <!-- 采集台账（collect_* 表）的 MyBatis-Plus 映射与分页能力 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-mybatis-starter</artifactId>
    </dependency>
    <!-- 数据源运行时契约：DSL 节点按名取数据源，交由引擎统一管理连接池；
         JDBC 驱动自动解析（JdbcDriverUtils）由其传递带入，不再重复声明 utils-support-datasource-starter（R7） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasource-starter</artifactId>
    </dependency>
    <!-- 数据源中心：SQL/入库节点统一从这里取数据源台账，不再自建 collect_datasource 台账。
         勿引入 spring-support-datasource-hub-starter：datapool 由 datasource-hub 改名而来，
         旧 hub jar 自带 com.chua.starter.datasourcehub.* 旧控制器，与 datapool 新控制器
         同映射 /ms/datasource，后注册者会被遮蔽或引发映射冲突
         （真实事故：shared-collect 端点 404、list 不过滤）。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datapool-starter</artifactId>
    </dependency>
    <!-- 调度能力（可选）：由宿主决定是否引入，采集本体不依赖调度引擎 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-job-starter</artifactId>
      <!--
        可选依赖：采集本体不依赖调度器。

        排期能力收口在 com.chua.starter.collect.schedule.CollectFlowSchedulePort：
        消费方引入 job-starter 时由 JobFlowSchedulePort 落到 sys_job 台账（行为不变）；
        不引入时由 LocalOnlyFlowSchedulePort 兜底——流程照常设计、手动执行、看结果，
        只是没有定时触发，启用排期会给出明确提示。

        所以这里必须 optional，否则"只想要采集能力"的模块会被动继承整套调度引擎
        （Leader 选举、sys_job_cluster、/v2/job 治理接口及其建表）。
        需要定时的消费方显式声明 job-starter 依赖即可（本仓库的
        spring-api-support-collect-scheduler-starter 就是这么做的）。
      -->
      <optional>true</optional>
    </dependency>
    <!-- 网页/接口抓取引擎：HTTP 采集节点的正文抽取与资源抓取 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-crawler-starter</artifactId>
    </dependency>
    <!-- 底层通用工具：序列化、反射、字符串与集合等采集节点共用能力 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
    </dependency>
    <!-- 脚本任务引擎：提供 common-starter ScriptProvider SPI 的 groovy 实现（ScriptFlow） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-groovy-starter</artifactId>
    </dependency>
    <!-- Groovy 运行时：脚本节点编译执行所需的语言实现（由宿主提供版本） -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
    </dependency>
    <!-- Web 容器：采集节点暴露的 HTTP 触发端点与控制器层 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- HTML 解析：CSS 选择器抽取器（CssSelectorNode）依赖的 DOM 解析库 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
    </dependency>
    <!-- 邮件通知：CollectEmailNotifyChannel / CollectJobEmailAlarmNotifier 直接使用 jakarta.mail 的 MimeMessage 组报文，
         发信实现（SMTP 传输）由宿主的邮件渠道提供；仅需 API 制品，版本由 Boot BOM 管理 -->
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
    </dependency>
    <!-- 接口文档注解（@Tag / @Operation / @Schema）：统一由 swagger-starter 以 provided 提供，不进运行时 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-swagger-starter</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- MySQL 驱动（runtime）：采集结果落库与作业台账连接，部署侧也可外部提供 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- collect_record 全文检索：Lucene 内嵌倒排索引（索引随落库同步更新） -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-core</artifactId>
    </dependency>
    <!-- Lucene 查询解析：把检索框表达式转成倒排索引查询 -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-queryparser</artifactId>
    </dependency>
    <!-- 中文分词与停用词：采集记录检索的中文查询分析器 -->
    <dependency>
      <groupId>org.apache.lucene</groupId>
      <artifactId>lucene-analysis-common</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/java</directory>
        <includes>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
