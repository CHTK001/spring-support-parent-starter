<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support Template Starter - 模板库管理模块

    提供基于 vue-plugin-hiprint 的标签/单据/凭证模板管理：
      模板分页检索、模板设计器数据、打印机（自发现/默认）配置。

    @author CH
    @since 4.0.0.52
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父项目配置 -->
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <!-- 项目基本信息 -->
    <artifactId>spring-support-template-starter</artifactId>
    <description>模板库管理模块（hiprint 标签/单据模板设计与打印机配置）</description>

    <!-- 依赖配置 -->
    <dependencies>
        <!-- Web 支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis Plus (Spring Boot 4) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- Spring Support MyBatis (PageResult / 分页拦截器) -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- Spring Support Common -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- Swagger 注解（模块 Controller 文档） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试依赖 -->

    </dependencies>

    <!-- 构建期：src/main/resources/db/init → target/db/V2.0__init_all.sql -->
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/test/resources</directory>
            </resource>
        </resources>
    </build>

</project>
