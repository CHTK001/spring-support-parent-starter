<?xml version="1.0" encoding="utf-8"?>
<!--
    Spring Support Channel Starter - 渠道管理独立模块

    从 spring-support-ai-starter 拆出的「账号类渠道」能力，供 AI 应用按需复用：
    1. 渠道账号鉴权（/api/channels）：Cline / Qoder / Trae / Gemini / MiniMax / Loomy 等
       账号类渠道的绑定、轮询、刷新、签到、模型拉取（SPI：AccountChannelAuthManager + 14 个实现）
    2. 渠道健康探针（/v2/channels）：探针状态机、健康记录持久化与定时探测
    3. 渠道定时任务：自动签到（ChannelCheckinTask）、健康探测（ChannelHealthProbeTask）

    依赖方向固定为 spring-support-ai-starter → 本模块（单向，不允许反向依赖）。
    本模块内的类沿用 com.chua.starter.ai.support.* 包名，保证 AI 侧既有 import 与
    AI 应用既有的 @ComponentScan / @MapperScan 口径完全不变。

    @author CH
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- 继承父项目配置 -->
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
  </parent>
  <!-- 项目基本信息 -->
  <artifactId>spring-support-channel-starter</artifactId>
  <description>Spring Support框架渠道管理模块，提供账号类渠道鉴权（OAuth/设备码/扫码）、渠道健康探针与渠道定时任务</description>
  <!-- 依赖配置 -->
  <dependencies>
    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Spring Support Common：@Permission 鉴权注解、ApiReturnFormatIgnore、Json 序列化 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <!-- OAuth 客户端：AiUserContext 读取当前登录用户（AuthSessionUtils / UserResume） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-oauth-client-starter</artifactId>
    </dependency>
    <!-- MyBatis Plus：渠道健康记录与提供商账号连接持久化 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <!-- Spring Support MyBatis（审计基类与 Mapper 约定） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-mybatis-starter</artifactId>
    </dependency>
    <!-- Swagger Annotations（/v2/channels 接口文档） -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <!-- Web support（@RestController / SseEmitter） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 自动配置注解（@AutoConfiguration / TransactionTemplate） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- 接码 / 临时邮箱 SPI：SmsCodeProvider / EmailProvider，用于短信 / 邮件渠道的薄适配
         （SmsChannelAdapter / EmailChannelAdapter）。utils 层为向下依赖，合法 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-datasearch-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- 免登录对话 / 文生图渠道的 ChatClient 实现：
         duckduckgo（duck / duckduckgo 别名）与 trae（trae / trae-cn / trae-global 别名，
         复用 Trae IDE 本地登录态，另含文生图 tool_text_to_image 协议）。
         渠道侧只按扩展名解析，缺失时优雅降级为「空模型 + 明确提示」，
         因此宿主工程如不需要可在自己的 pom 里排除这两个依赖 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-duckduckgo-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-trae-starter</artifactId>
      <version>${utils.version}</version>
    </dependency>
    <!-- 单元测试：Spi 实现的报文/签名回归探针 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <encoding>UTF-8</encoding>
          <proc>full</proc>
          <compilerArgs>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 本仓约定非 example 模块的回归探针以 *Probe 承载，声明 includes 会整体替换
               surefire 默认模式，故四种默认模式必须一并保留。 -->
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*Probe.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
