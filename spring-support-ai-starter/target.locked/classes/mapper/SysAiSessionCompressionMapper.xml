<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.ai.support.mapper.SysAiSessionCompressionMapper">

    <!--
        按会话 ID 查询压缩上下文。
        用于获取 AI 会话的上下文压缩状态，为空时返回 null。
    -->
    <select id="selectBySessionId" resultType="com.chua.starter.ai.support.entity.SysAiSessionCompression">
        SELECT *
        FROM sys_ai_session_compression
        WHERE sys_ai_session_id = #{sessionId}
        LIMIT 1
    </select>

</mapper>
