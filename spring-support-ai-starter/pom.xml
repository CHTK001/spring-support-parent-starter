<?xml version="1.0" encoding="utf-8"?>
<!--
    Spring Support AI Starter - AI深度学习功能模块

    这是Spring Support框架的AI模块，提供了企业级应用中常用的AI深度学习功能。
    包含以下主要功能：

    1. 人脸检测 - 检测图片中的人脸位置
    2. 人脸特征值 - 提取人脸特征向量
    3. 图片检测 - 检测图片中的物体
    4. 图片特征值 - 提取图片特征向量
    5. 文本特征值 - 提取文本特征向量
    6. OCR识别 - 光学字符识别
    7. 版面分析 - 文档版面结构分析
    8. 性别年龄 - 人脸性别年龄检测

    @author CH
    @version ********
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- 继承父项目配置 -->
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
  </parent>
  <!-- 项目基本信息 -->
  <artifactId>spring-support-ai-starter</artifactId>
  <description>Spring Support框架AI深度学习功能模块，提供人脸检测、特征提取、OCR、版面分析等AI能力</description>
  <!-- 项目属性配置 -->
  <properties>
    <!-- 作为内部 starter 被依赖模块使用时默认跳过 fat-jar repackage，保留原始 jar 结构；
             需要可执行包时构建传 -Dspring-boot.repackage.skip=false，产物为 *-exec.jar，主构件不受影响 -->
    <!-- 网页正文提取（知识库按网址采集：去脚本/样式/导航，还原 HTML 实体） -->
    <jsoup.version>1.23.2</jsoup.version>
  </properties>
  <!-- 依赖版本钉死：钉钉 SDK 的部分传递依赖使用版本区间（如 com.aliyun:tea:[1.1.14,2.0.0)），
       离线构建无法解析区间；这里固定为本地仓库已有版本，避免联网拉取 maven-metadata。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>tea</artifactId>
        <version>1.4.2</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>tea-openapi</artifactId>
        <version>0.3.17</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>tea-util</artifactId>
        <version>0.2.28</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>tea-xml</artifactId>
        <version>0.1.7</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>openapiutil</artifactId>
        <version>0.2.5</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>endpoint-util</artifactId>
        <version>0.0.8</version>
      </dependency>
      <dependency>
        <groupId>com.aliyun</groupId>
        <artifactId>alibabacloud-gateway-spi</artifactId>
        <version>0.0.3</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <!-- 依赖配置 -->
  <dependencies>
    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Git 操作：仅引入 JGit 本体，避免 git-starter 传递依赖拉低现有 utils 版本 -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <version>7.8.0.202609011348-r</version>
    </dependency>
    <!-- 终端 PTY：pty4j 在 Windows 走 ConPTY、Unix 走原生 libpty，支撑 vim/top 等交互式程序 -->
    <dependency>
      <groupId>org.jetbrains.pty4j</groupId>
      <artifactId>pty4j</artifactId>
      <version>0.14.0</version>
    </dependency>
    <!-- OpenAI 兼容协议 ChatClient（OpenAI/SiliconFlow/SenseTime/GitHub/Gitee） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-openai-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- MOSS 开放平台（mosi.cn）：文生图 MossImageClient + 语音合成 MossTextToAudioClient -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-mosi-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- 智谱 GLM ChatClient（zhipu/glm SPI） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-zhipu-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- Z.AI ChatClient（zai SPI） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-zai-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- 深度学习能力（OCR 识别、向量模型等） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-deeplearning-starter</artifactId>
    </dependency>
    <!-- Agent 编排运行时（AgentScope：多 Agent 协作、子 Agent 路由/流水线/扇出） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-deeplearning-agentscope-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- iLink 微信 Bot 扫码登录 SDK -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-ilink-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- 飞书 Bot（凭据配置型：appId/appSecret） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-feishu-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- QQ Bot（凭据配置型：appId/appSecret，WebSocket 长连接） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-qq-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- 钉钉 Bot（凭据配置型：AppKey/AppSecret，Stream 长连接，无需公网回调） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-dingding-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- WhatsApp Cloud API Bot（凭据配置型：phone_number_id/access_token/app_secret/verify_token，Webhook 收发） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-whatsapp-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- ONNX 模型注册器（OCR 识别、文本向量等模型实现）。
         注意：这里只引「实现」，不引「权重」——具体模型构件（utils-support-models-onnx-*）
         由各应用按需声明，否则每个下游可执行 jar 都会被捆绑上百兆权重 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-deeplearning-onnx-starter</artifactId>
    </dependency>
    <!-- SafeTensor Python 推理服务桥：Indra OCR 等端到端文档解析模型注册
         （Java 侧 ModelRegistrar + HTTP 客户端，Python 服务由 utils-support-parent-starter
          的 safetensors python_service 提供） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-deeplearning-safetensors-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-jvector-starter</artifactId>
    </dependency>
    <!-- jvector 核心库：确保 fat-jar 运行时含 native VectorizationProvider（ON_DISK 向量存储依赖） -->
    <dependency>
      <groupId>io.github.jbellis</groupId>
      <artifactId>jvector</artifactId>
      <version>4.0.1</version>
    </dependency>
    <!-- jvector 传递依赖 agrona：缺省会 ClassNotFoundException org.agrona.collections.IntArrayList -->
    <dependency>
      <groupId>org.agrona</groupId>
      <artifactId>agrona</artifactId>
      <version>1.20.0</version>
    </dependency>
    <!-- Milvus 向量数据库（远程服务型：host/port/集合/令牌，由 VectorStorageProvider SPI
         描述器驱动的配置表单填写；凭据属敏感字段，后端保存后不回显） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-milvus-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- RAG 文档文本提取：PDF / Word（按扩展名自动分发） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-pdf-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-word-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- RAG 文档文本提取：Tika 通用兜底（pptx/ppt/html/xml/rtf/epub/msg/eml 等） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-tika-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- 网页正文提取（JSoup）：知识库按网址采集时需要去脚本/样式/导航并还原 HTML 实体 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-crawler-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>
    <!-- 用量数据同步（datasearch UsageProvider 外部工具用量拉取） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-datasearch-starter</artifactId>
      <version>4.0.0.50</version>
    </dependency>
    <!-- r2dbc-spi 锁定 0.9.1，防止 Spring Boot BOM 升级到 1.0.x（移除了 ConnectionFactoryOptions） -->
    <dependency>
      <groupId>io.r2dbc</groupId>
      <artifactId>r2dbc-spi</artifactId>
      <version>0.9.1.RELEASE</version>
    </dependency>
    <!-- 文件系统（服务器目录浏览、分片上传） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-filesystem-starter</artifactId>
    </dependency>
    <!-- SSH 客户端（远程主机连接：真实握手、命令执行，基于 Apache MINA SSHD） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-ssh-starter</artifactId>
    </dependency>
    <!-- Spring Support Common -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <!-- 渠道管理模块（账号类渠道鉴权 /api/channels、渠道健康探针 /v2/channels、
         渠道定时签到与探针、AccountChannelAuthManager SPI 及其 14 个实现）。
         依赖方向固定为 ai-starter → channel-starter，本模块不再反向依赖。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-channel-starter</artifactId>
    </dependency>
    <!-- OAuth 客户端鉴权（@Permission 管理端接口鉴权、AuthController/UserAuthController 认证） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-oauth-client-starter</artifactId>
    </dependency>
    <!-- RPC 提供者（Dubbo 3.3.6 / 事件协议）：把 AI 能力暴露为 RPC 接口，
         消费方用 @RpcResource 注入代理，RPC 断连时自动熔断降级到本应用的本地 Bean
         （degrade = "springbean"），实现「Bean 即 RPC」的永久降级。
         默认关闭：plugin.rpc.enable 必须显式为 true 才注册服务项目。 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-rpc-starter</artifactId>
    </dependency>
    <!-- 顶栏天气 / 定位 / 台风（/v2/weather/overview、/v2/location/resolve、/v2/typhoon/**）：
         平台可选增强能力，与 api 侧宿主共用同一份实现；自动配置注册，@ComponentScan 无需覆盖。
         前端探测命中即走本模块，未命中回落三方（见 vue-support-parent-starter other.capabilities） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasearch-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- MyBatis Plus -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <!-- Spring Support MyBatis（SysBase 审计基类） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-mybatis-starter</artifactId>
    </dependency>
    <!-- Swagger Annotations -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <!-- Web support (for HttpServletRequest) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- WebSocket（nomifun 前端 /ws 流式响应与推送契约） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- MCP（Model Context Protocol）Java SDK - 真实 MCP 服务器连接 / 工具列举 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>1.0.1</version>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-core</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- JWT 认证（nomifun 前端 OAuth 对接） -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.37.3</version>
    </dependency>
    <!-- 数据源模块 - 提供 Flyway-like 迁移器（db/init 脚本自动执行） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-datasource-starter</artifactId>
    </dependency>
    <!-- MySQL 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 缓存功能模块 - 提供缓存常量 CacheConstant -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-cache-starter</artifactId>
    </dependency>
    <!-- Caffeine Cache -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <!-- Redis for cache -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio-jvm</artifactId>
      <version>3.18.2</version>
    </dependency>
    <!-- 单元测试：版本由继承的 spring-boot-dependencies 统一管理 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <encoding>UTF-8</encoding>
          <proc>full</proc>
          <compilerArgs>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- 继承父 POM 的堆限制，并补 enable-preview 选项：common-starter 的 DefaultPipeline
               是 Java 25 preview 类（class file 69.65535），测试 JVM 不开 preview 时
               凡是构建 OcrPipeline 等任务管线的用例都会抛 UnsupportedClassVersionError。
               与 utils-support 父 POM 的 enable.preview.jvm.args 语义保持一致。 -->
          <argLine>-Xms256m -Xmx2g --enable-preview</argLine>
          <!-- 本仓约定非 example 模块的回归探针以 *Probe 承载（如 CacheManagerResolverProbe）。
               声明 includes 会整体替换 surefire 默认模式，故四种默认模式必须一并保留。 -->
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*Probe.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.chua.starter.ai.support.AiStarterApplication</mainClass>
          <!-- 可执行包另挂 exec 分类符，绝不替换主构件：库坐标下必须始终是薄 jar，否则按类路径引本模块的进程解析不到 com/chua/... 根路径类 -->
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>