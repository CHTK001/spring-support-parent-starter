# =============================================================================
# app.env.example - 部署参数模板（复制为 config/app.env 后修改）
#
# config/app.env 不入仓库：里面有数据库口令与演示账号口令。
# start.sh 会在启动前 source 它，因此这里的变量优先级高于脚本内置默认值。
#
#   cp config/app.env.example config/app.env
#   chmod 600 config/app.env
#   vi config/app.env
# =============================================================================

# ---------------------------------------------------------------- 端口
PORT=8787

# ---------------------------------------------------------------- JVM
# 堆上限按 8GB 内存机器给（系统 + MariaDB + Redis 共存）。
# 本机曾因堆过大被 OOM 杀掉，不要随手调大。
#
# 注意：JAVA_OPTS 是**整体覆盖**（start.sh 写的是 ${JAVA_OPTS:-默认值}）。
# 只要这一行存在，脚本内置的默认值就全部失效 —— 加参数时别漏项。
# --enable-preview 刻意**不放在这里**：它由 start.sh 的 REQUIRED_JAVA_FLAGS 提供，
# 不受本文件影响。代码以预览特性编译（class 文件 minor=65535），运行时缺它会报
# UnsupportedClassVersionError，而该错误只在真正加载到预览类时才暴露，
# 启动期一切正常，极具迷惑性。
JAVA_OPTS="-Xms512m -Xmx2560m -Duser.timezone=Asia/Shanghai -Djava.net.preferIPv4Stack=true"

# ---------------------------------------------------------------- 模型目录
# 模型根由 yaml 默认值 models/onnx 决定，相对**进程 CWD** 解析。
# start.sh 会先 cd 到 APP_DIR 再启动，所以实际根 = $APP_DIR/models/onnx。
# 权重不随 jar 分发（ai-starter 的 pom 只引实现、不引模型构件），
# 需要手工放进去，路径与模型注册表里的资源路径一致，例如：
#   models/onnx/face/detection/scrfd/2.5g_bnkps.onnx      （人脸检测）
#   models/onnx/face/swap/common/buffalo_l/w600k_r50.onnx （人脸特征，512 维）
# 放好后在「人脸重识别配置」里把 detector_model / feature_model 指过去即可。

# ---------------------------------------------------------------- 启动参数
# local profile 已提供：redis 127.0.0.1:6379、datasource jdbc:mysql://localhost:3306/ai_test
# 演示用的静态账号必须从命令行/环境传入，绝不写进仓库。
APP_ARGS="--spring.profiles.active=local --plugin.oauth.temp.user=admin:admin123"

# ---------------------------------------------------------------- 数据库
# 需要改数据源时用 Spring Boot 的环境变量绑定（等价于 spring.datasource.*），
# 不要写成命令行参数：命令行会出现在 /proc/<pid>/cmdline，本地任意用户 ps 可见。
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ai_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# SPRING_DATASOURCE_USERNAME=ai
# SPRING_DATASOURCE_PASSWORD=ai

# ---------------------------------------------------------------- 启动超时
# 含模型加载，冷启动约 5~20s；给足窗口，超时后 start.sh 会打印日志尾部并非 0 退出。
START_TIMEOUT=180
