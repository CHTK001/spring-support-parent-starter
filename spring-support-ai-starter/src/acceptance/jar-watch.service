[Unit]
Description=ai-starter app.jar watcher (detect competing deploys)
Documentation=file:///opt/ai-starter/jar-watch.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /opt/ai-starter/jar-watch.sh
# 监视器要读写 /opt/ai-starter（root 属主）并在开启回滚时重启 ai-starter，故以 root 运行
User=root
Restart=always
RestartSec=10
# 日志同时进 journal，方便 journalctl -u jar-watch 查看
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
