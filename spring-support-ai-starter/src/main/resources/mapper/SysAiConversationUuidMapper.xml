<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.ai.support.mapper.SysAiConversationUuidMapper">

    <!--
        根据 UUID 查找对话 ID
    -->
    <select id="findDialogIdByUuid" resultType="java.lang.Long">
        SELECT dialog_id
        FROM sys_ai_conversation_uuid
        WHERE uuid = #{uuid}
    </select>

    <!--
        根据对话 ID 查找 UUID
    -->
    <select id="findUuidByDialogId" resultType="java.lang.String">
        SELECT uuid
        FROM sys_ai_conversation_uuid
        WHERE dialog_id = #{dialogId}
    </select>

</mapper>
