<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.ai.support.mapper.SysAiAppKeyMapper">

    <!--
        实体字段为无前缀风格（status/appKey/delete/groupId...），
        DB 列为 sys_ai_app_key_* 前缀风格，必须用 resultMap 显式映射，
        否则自动映射（resultType）无法把前缀列匹配到属性，导致 status 等字段为 null。
    -->
    <resultMap id="appKeyResultMap" type="com.chua.starter.ai.support.entity.SysAiAppKey">
        <id property="id" column="sys_ai_app_key_id"/>
        <result property="appId" column="sys_ai_app_key_app_id"/>
        <result property="appKey" column="sys_ai_app_key_app_key"/>
        <result property="secret" column="sys_ai_app_key_secret"/>
        <result property="name" column="sys_ai_app_key_name"/>
        <result property="status" column="sys_ai_app_key_status"/>
        <result property="deleted" column="sys_ai_app_key_delete"/>
        <result property="userId" column="sys_ai_app_key_user_id"/>
        <result property="groupId" column="sys_ai_app_key_group_id"/>
        <result property="providerId" column="sys_ai_app_key_provider_id"/>
        <result property="model" column="sys_ai_app_key_model"/>
        <result property="enabled" column="sys_ai_app_key_enabled"/>
        <result property="expireDatetime" column="sys_ai_app_key_expire_datetime"/>
        <result property="expireTime" column="sys_ai_app_key_expire_time"/>
        <result property="validDays" column="sys_ai_app_key_valid_days"/>
        <result property="ipWhitelist" column="sys_ai_app_key_ip_whitelist"/>
        <result property="lastUsedTime" column="sys_ai_app_key_last_used_time"/>
        <result property="useCount" column="sys_ai_app_key_use_count"/>
        <result property="maxUse" column="sys_ai_app_key_max_use"/>
        <result property="maxTokens" column="sys_ai_app_key_max_tokens"/>
        <result property="totalTokens" column="sys_ai_app_key_total_tokens"/>
        <result property="balance" column="sys_ai_app_key_balance"/>
        <result property="planId" column="sys_ai_app_key_plan_id"/>
        <result property="overdraftEnabled" column="sys_ai_app_key_overdraft_enabled"/>
        <result property="minuteRate" column="sys_ai_app_key_minute_rate"/>
        <result property="totalCost" column="sys_ai_app_key_total_cost"/>
        <result property="scope" column="sys_ai_app_key_scope"/>
        <result property="remark" column="sys_ai_app_key_remark"/>
        <result property="createName" column="create_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateName" column="update_name"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <!--
        按 AppKey 值查询应用密钥。
        用于 Bearer Token 验证和 AppKey 校验。
    -->
    <select id="selectByAppKey" resultMap="appKeyResultMap">
        SELECT *
        FROM sys_ai_app_key
        WHERE sys_ai_app_key_app_key = #{appKey}
          AND sys_ai_app_key_delete = 0
        LIMIT 1
    </select>

    <!--
        按分组 ID 查询该分组下所有应用密钥。
    -->
    <select id="selectByGroupId" resultMap="appKeyResultMap">
        SELECT *
        FROM sys_ai_app_key
        WHERE sys_ai_app_key_group_id = #{groupId}
          AND sys_ai_app_key_delete = 0
        ORDER BY create_time DESC
    </select>

    <!--
        原子自增使用次数。
    -->
    <update id="updateUseCount">
        UPDATE sys_ai_app_key
        SET sys_ai_app_key_use_count = COALESCE(sys_ai_app_key_use_count, 0) + 1
        WHERE sys_ai_app_key_app_key = #{appKey}
          AND sys_ai_app_key_delete = 0
    </update>

    <!--
        原子累加 Token 消耗量。
    -->
    <update id="addTokenQuota">
        UPDATE sys_ai_app_key
        SET sys_ai_app_key_total_tokens = COALESCE(sys_ai_app_key_total_tokens, 0) + #{tokens}
        WHERE sys_ai_app_key_app_key = #{appKey}
          AND sys_ai_app_key_delete = 0
    </update>

    <!--
        原子扣费：余额减少、累计费用增加，一条 SQL 完成，避免并发下丢失更新。
        「余额不为负」与「是否允许透支」的判断也放在 WHERE 里，与扣减在同一行锁内完成：
        余额已为负且未开透支时受影响行数为 0，调用方据此判定「没扣成」。
    -->
    <update id="deductBalance">
        UPDATE sys_ai_app_key
        SET sys_ai_app_key_balance = COALESCE(sys_ai_app_key_balance, 0) - #{amount},
            sys_ai_app_key_total_cost = COALESCE(sys_ai_app_key_total_cost, 0) + #{amount}
        WHERE sys_ai_app_key_app_key = #{appKey}
          AND sys_ai_app_key_delete = 0
          AND (COALESCE(sys_ai_app_key_balance, 0) &gt;= 0 OR COALESCE(sys_ai_app_key_overdraft_enabled, 0) = 1)
    </update>

</mapper>
