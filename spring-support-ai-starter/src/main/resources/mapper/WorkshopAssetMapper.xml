<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.ai.support.mapper.WorkshopAssetMapper">

    <!-- 显式列名映射：表列带 asset_ 前缀，与实体字段名不同，不能用 resultType 自动映射 -->
    <resultMap id="assetMap" type="com.chua.starter.ai.support.entity.WorkshopAsset">
        <id property="assetId" column="asset_id"/>
        <result property="kind" column="asset_kind"/>
        <result property="title" column="asset_title"/>
        <result property="collection" column="asset_collection"/>
        <result property="tags" column="asset_tags"/>
        <result property="mime" column="asset_mime"/>
        <result property="width" column="asset_width"/>
        <result property="height" column="asset_height"/>
        <result property="bytes" column="asset_bytes"/>
        <result property="inLibrary" column="asset_in_library"/>
        <result property="textContent" column="asset_text_content"/>
        <result property="origin" column="asset_origin"/>
        <result property="filePath" column="asset_file_path"/>
        <result property="thumbPath" column="asset_thumb_path"/>
        <result property="createdAt" column="asset_created_at"/>
        <result property="updatedAt" column="asset_updated_at"/>
        <result property="userId" column="asset_user_id"/>
    </resultMap>

    <!-- 复用：查询过滤条件片段（userId 非空即按归属过滤；传 null 表示管理员查全量） -->
    <sql id="filterWhere">
        <where>
            <if test="userId != null and userId != ''">
                AND asset_user_id = #{userId}
            </if>
            <if test="inLibrary != null">
                AND asset_in_library = #{inLibrary}
            </if>
            <if test="kind != null and kind != ''">
                AND asset_kind = #{kind}
            </if>
            <choose>
                <when test="ungrouped">
                    AND (asset_collection IS NULL OR asset_collection = '')
                </when>
                <when test="collection != null and collection != ''">
                    AND asset_collection = #{collection}
                </when>
            </choose>
            <if test="tag != null and tag != ''">
                AND JSON_SEARCH(asset_tags, 'one', #{tag}) IS NOT NULL
            </if>
            <if test="query != null and query != ''">
                AND (
                    asset_title LIKE CONCAT('%', #{query}, '%') ESCAPE '\\'
                    OR JSON_SEARCH(asset_tags, 'one', #{query}) IS NOT NULL
                )
            </if>
        </where>
    </sql>

    <select id="selectIdsByCollection" resultType="java.lang.String">
        SELECT asset_id FROM workshop_asset WHERE asset_collection = #{collection}
    </select>

    <select id="selectIdsByTags" resultType="java.lang.String">
        SELECT asset_id FROM workshop_asset WHERE JSON_SEARCH(asset_tags, 'one', #{query}) IS NOT NULL
    </select>

    <select id="selectPageByFilter" resultMap="assetMap">
        SELECT * FROM workshop_asset
        <include refid="filterWhere"/>
        ORDER BY
        <choose>
            <when test="sort == 'created_asc'">asset_created_at ASC</when>
            <when test="sort == 'updated_desc'">asset_updated_at DESC</when>
            <when test="sort == 'updated_asc'">asset_updated_at ASC</when>
            <when test="sort == 'name_asc'">asset_title ASC</when>
            <when test="sort == 'size_desc'">asset_bytes DESC</when>
            <when test="sort == 'size_asc'">asset_bytes ASC</when>
            <otherwise>asset_created_at DESC</otherwise>
        </choose>
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countByFilter" resultType="long">
        SELECT COUNT(*) FROM workshop_asset
        <include refid="filterWhere"/>
    </select>

    <select id="selectDistinctCollections" resultType="java.lang.String">
        SELECT DISTINCT asset_collection
        FROM workshop_asset
        WHERE asset_collection IS NOT NULL AND asset_collection != ''
        <if test="userId != null and userId != ''">
            AND asset_user_id = #{userId}
        </if>
        ORDER BY asset_collection
    </select>

    <update id="updateMeta">
        UPDATE workshop_asset
        <set>
            <if test="title != null">
                asset_title = #{title},
            </if>
            <if test="collection != null">
                asset_collection = CASE WHEN #{collection} = '' THEN NULL ELSE #{collection} END,
            </if>
            <if test="tagsJson != null">
                asset_tags = #{tagsJson},
            </if>
            <if test="inLibrary != null">
                asset_in_library = #{inLibrary},
            </if>
            asset_updated_at = #{updatedAt}
        </set>
        WHERE asset_id = #{assetId}
    </update>

    <update id="renameCollection">
        UPDATE workshop_asset
        SET asset_collection = CASE WHEN #{to} IS NULL OR #{to} = '' THEN NULL ELSE #{to} END
        WHERE asset_collection = #{from}
        <if test="userId != null and userId != ''">
            AND asset_user_id = #{userId}
        </if>
    </update>

</mapper>
