<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support EduAI Starter - 教育AI集成模块

    这是Spring Support框架的教育AI模块，提供AI辅助教学核心能力。
    主要特性包括：

    1. 题库管理 - 题目录入、导入、分类筛选
    2. AI组卷 - 根据知识点/难度/题型自动生成试卷
    3. AI阅卷 - 主观题自动批改，客观题自动判分
    4. 知识库 - 文档向量检索，语义搜索
    5. 错题库 - 错题自动记录，个性化复习推荐

    @author CH
    @version 4.0.0.42
-->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>

    <artifactId>spring-support-eduai-starter</artifactId>
    <description>Spring Support框架教育AI模块，提供题库管理、AI组卷、AI阅卷、知识库、错题库等AI教学能力</description>

    <dependencies>
        <!-- 通用功能模块 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- MyBatis Plus 基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 数据源（提供 MaterializedSqlDataSourceRouter 等动态路由） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>

        <!-- Redis 缓存 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-redis-starter</artifactId>
        </dependency>

        <!-- Spring Data Redis（spring-data-redis-serializer 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redisson（spring-support-redis-starter 内部依赖，未正确导入时手动补齐） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.36.0</version>
        </dependency>

        <!-- 消息队列（异步阅卷任务） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-queue-starter</artifactId>
        </dependency>

        <!-- 定时任务（题库采集调度 edu-collect-dispatch） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
        </dependency>

        <!-- 采集平台能力（/v2/collect/** 的 14 个 Controller + 流程图执行引擎）。

             eduai 的「采集管理」已收敛到采集平台统一实现：前端路由 /edu/collect 指向
             @pages/collect 的采集器管理页，该页所有请求都打 /v2/collect/**，接口由本依赖提供。
             不加这条依赖时页面能加载出来，但每个请求都会 404。

             该 artifact 由 spring-support-api-starter 构建产出，不在本 reactor 模块树内，
             版本由父 pom 的 dependencyManagement 统一管理（4.0.0.42）。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-api-support-collect-starter</artifactId>
        </dependency>

        <!-- 深度学习/AI推理 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-deeplearning-starter</artifactId>
        </dependency>

        <!-- AI 聚合能力（对话、模型、用量） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- OAuth 客户端权限注解 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
        </dependency>

        <!-- OSGi 源码扩展点：把「学生凭据校验」这类 SPI 实现改为源码声明，
             改动源码即生效、无需重新构建整个 jar。默认配置已开启，
             未放置源码时自动跳过，不产生任何副作用。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-osgi-starter</artifactId>
        </dependency>

        <!-- 单元测试：覆盖学生口令摘要/校验这类安全核心逻辑。
             刻意不引 mockito：被测对象是纯函数（无外部依赖），
             打桩只会掩盖真实行为。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Swagger 注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- ONNX 模型资产（paddleocrv6-tiny / ppdoclayoutv3 / doc-orientation）
             嵌入式小模型（6.4MB / 124.5MB / 6.5MB，共约 137MB），不走下载：
             - 已从 maven 依赖移除（com/chua 本地仓库已清理），源文件见 utils-support-models-parent 各模块 src/main/resources；
             - classpath 相对路径由 OnnxModelRegistrar 注册项约定（ocr/PP-OCRv6/tiny/…、vision/detection/pp_doc_layoutv3/…、ocr/direction/doc_ori/…）；
             - 部署时随包提供：放入模型目录（-Ddeeplearning.model.root-dir 指定，默认 models/onnx）或直接打入应用资源。
        -->

        <!-- 测试依赖 -->
        
    </dependencies>

<build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/test/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 编译参数（fork / UTF-8 / -parameters / -proc:full / 整套 add-opens）继承父 pom，
                         此处只补充父 pom 未声明的注解处理器；不要在此覆盖 compilerArgs，
                         Maven 的 plugin configuration 是整体替换而非合并，覆盖会丢掉父 pom
                         传给 JVM 的 add-opens 参数，lombok 在 JDK 25 下将无法访问 javac 内部包 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>

                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.chua.starter.eduai.EduAiApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>