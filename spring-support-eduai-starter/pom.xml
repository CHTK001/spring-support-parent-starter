<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support EduAI Starter - 教育AI集成模块

    这是Spring Support框架的教育AI模块，提供AI辅助教学核心能力。
    主要特性包括：

    1. 题库管理 - 题目录入、导入、分类筛选
    2. AI组卷 - 根据知识点/难度/题型自动生成试卷
    3. AI阅卷 - 主观题自动批改，客观题自动判分
    4. 知识库 - 文档向量检索，语义搜索
    5. 错题库 - 错题自动记录，个性化复习推荐

    @author CH
    @version 4.0.0.42
-->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>

    <artifactId>spring-support-eduai-starter</artifactId>
    <description>Spring Support框架教育AI模块，提供题库管理、AI组卷、AI阅卷、知识库、错题库等AI教学能力</description>

    <dependencies>
        <!-- 通用功能模块 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- MyBatis Plus 基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 数据源（提供 MaterializedSqlDataSourceRouter 等动态路由） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>

        <!-- Redis 缓存 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-redis-starter</artifactId>
        </dependency>

        <!-- Spring Data Redis（spring-data-redis-serializer 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redisson（spring-support-redis-starter 内部依赖，未正确导入时手动补齐） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.36.0</version>
        </dependency>

        <!-- 消息队列（异步阅卷任务） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-queue-starter</artifactId>
        </dependency>

        <!-- 定时任务（题库采集调度 edu-collect-dispatch） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
        </dependency>

        <!-- Groovy 脚本采集源（GROOVY 类型的 QuestionSourceProvider） -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-json</artifactId>
        </dependency>

        <!-- 深度学习/AI推理 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-deeplearning-starter</artifactId>
        </dependency>

        <!-- AI 聚合能力（对话、模型、用量） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- OAuth 客户端权限注解 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
        </dependency>

        <!-- OSGi 源码扩展点：把「学生凭据校验」这类 SPI 实现改为源码声明，
             改动源码即生效、无需重新构建整个 jar。默认配置已开启，
             未放置源码时自动跳过，不产生任何副作用。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-osgi-starter</artifactId>
        </dependency>

        <!-- Swagger 注解 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- ==================== 本地 ONNX 模型资产（阅卷必需） ====================
             spring-support-ai-starter 刻意「只引实现、不引权重」，模型资产由宿主应用按需选择。
             这里补齐阅卷链路所需的三类资产，否则运行期会以「取不到资源」失败：

             1) paddleocrv6-tiny  —— OCR 检测 + 识别 + 字符字典
                translator 从 classpath 读 ocr/PP-OCRv6/tiny/rec_infer/inference.yml 作字符表；
                缺该 jar 时字典退化为空表，识别结果全部为空串（且不抛错，极难排查）。
             2) ppdoclayoutv3     —— 版面分析（PP-DocLayoutV3，25 类区域），阅卷的「版面还原」环节
             3) doc-orientation   —— 整图方向矫正（0/90/180/270）。该模型注册项没有下载 URL，
                只能随包提供；不引则方向矫正不可用（可选项，缺失不影响识别主干）
        -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-models-onnx-paddleocrv6-tiny</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-models-onnx-ppdoclayoutv3</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-models-onnx-doc-orientation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试依赖 -->
        
    </dependencies>

<build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/test/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 编译参数（fork / UTF-8 / -parameters / -proc:full / 整套 add-opens）继承父 pom，
                         此处只补充父 pom 未声明的注解处理器；不要在此覆盖 compilerArgs，
                         Maven 的 plugin configuration 是整体替换而非合并，覆盖会丢掉父 pom
                         传给 JVM 的 add-opens 参数，lombok 在 JDK 25 下将无法访问 javac 内部包 -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>

                        <path>
                            <groupId>com.uber.nullaway</groupId>
                            <artifactId>nullaway</artifactId>
                            <version>${nullaway.version}</version>
                        </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.chua.starter.eduai.EduAiApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>