[Unit]
Description=EDUAI backend (spring-support-eduai-starter), port 19095
Documentation=file:///home/kali/eduai/backend/deploy/README.md
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=kali
Group=kali
WorkingDirectory=/home/kali/eduai/backend

# 凭据与密钥都不入仓库、不写进本文件：
#   /etc/eduai/ai-chat.env  AI_CHAT_APP_KEY=...（可选：缺失时 AI 功能不可用）
#   /etc/eduai/eduai.env    数据源口令 / oauth 地址（必需：缺失即启动失败，
#                           因为 ExecStart 用 ${} 引用它们，systemd 展开不到就报错）
# 模板见 deploy/eduai.env.example。
EnvironmentFile=-/etc/eduai/ai-chat.env
EnvironmentFile=/etc/eduai/eduai.env

# --enable-preview 为必需：OCR/版面管线构建在 DefaultPipeline 上，其 class 头为
#   cafebabe ffff 0045（minor=0xFFFF=编译期 preview、major=69=Java25），
#   未开 preview 时加载即抛 UnsupportedClassVersionError，相关接口全部 500。
# 模型目录与 java.io.tmpdir 都指向持久盘：默认 cache/tmp 落在 /tmp，而本机
# /tmp 是 tmpfs（重启即失，且占用内存）。
ExecStart=/usr/bin/java --enable-preview -XX:+UseCompactObjectHeaders \
    -Djava.net.preferIPv4Stack=true -Xmx2g \
    -Ddeeplearning.model.root-dir=/home/kali/eduai/backend/models/onnx \
    -Ddeeplearning.model.cache-dir=/home/kali/eduai/backend/models/cache \
    -Djava.io.tmpdir=/home/kali/eduai/backend/tmp \
    -jar /home/kali/eduai/backend/eduai-backend.jar \
    --server.port=${EDUAI_PORT} \
    --plugin.oauth.protocol=tcp \
    --plugin.oauth.address=${OAUTH_TCP_ADDRESS} \
    --plugin.oauth.auth-address=${OAUTH_TCP_ADDRESS} \
    --plugin.oauth.enable-encryption=false

# 数据源刻意**不**写成命令行参数：命令行会出现在 /proc/<pid>/cmdline，
# 本地任意用户 ps 可见。改由 EnvironmentFile 里的 SPRING_DATASOURCE_URL /
# _USERNAME / _PASSWORD 注入（Spring Boot 的环境变量绑定等价于
# spring.datasource.*），只在 /proc/<pid>/environ 里，仅属主/root 可读。

Restart=always
RestartSec=10
StandardOutput=append:/home/kali/eduai/logs/be.out.log
StandardError=append:/home/kali/eduai/logs/be.out.log

[Install]
WantedBy=multi-user.target
