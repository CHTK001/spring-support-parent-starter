# EDUAI 后端环境变量模板。
#
# 用法：
#   sudo install -d -m 0755 /etc/eduai
#   sudo install -m 0600 deploy/eduai.env.example /etc/eduai/eduai.env
#   sudo vi /etc/eduai/eduai.env      # 把 <...> 换成真实值
#
# 该文件由 eduai-backend.service 的 EnvironmentFile 加载；ExecStart 里用 ${} 引用，
# 因此**每个变量都必填**，缺失时 systemd 直接报错、服务不起（刻意如此：
# 宁可起不来，也不要用仓库里写死的口令跑起来）。不要把本文件提交进仓库。
#
# 记法：systemd 的 EnvironmentFile 是 KEY=VALUE，不要写 export，值也不要加引号。

# 服务端口
EDUAI_PORT=19095

# 数据源（eduai 库）
#
# 用 Spring Boot 的**环境变量绑定**（SPRING_DATASOURCE_* 等价于 spring.datasource.*），
# 而不是在 ExecStart 里写 --spring.datasource.password=...：
# 命令行参数会出现在 /proc/<pid>/cmdline（本地任意用户 ps 可见），
# 环境变量只在 /proc/<pid>/environ（仅属主/root 可读）。两个都不入仓库。
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/eduai?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=<eduai库账号>
SPRING_DATASOURCE_PASSWORD=<eduai库口令>

# 认证服务端（oauth）的 tcp 入口
OAUTH_TCP_ADDRESS=tcp://192.168.50.198:19180

# 可选：AI 对话密钥走 /etc/eduai/ai-chat.env（AI_CHAT_APP_KEY=...），本文件不放。
