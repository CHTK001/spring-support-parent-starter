<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.eduai.dimension.mapper.EduSubjectMapper">

    <!-- 列表学科：默认仅启用；includeDisabled=true 时连停用一起返回（管理端恢复入口依赖全量） -->
    <select id="listSubjects" resultType="com.chua.starter.eduai.dimension.entity.EduSubject">
        SELECT s.* FROM edu_subject s
        <where>
            <if test="includeDisabled != true">
                s.subject_status = 1
            </if>
            <if test="gradeLevel != null and gradeLevel != ''">
                AND s.subject_grade_levels LIKE CONCAT('%', #{gradeLevel}, '%')
            </if>
            <choose>
                <when test="scope.ownerPredicate != null">
                    AND (s.subject_owner_user_id IS NULL OR s.subject_owner_user_id = #{scope.ownerPredicate})
                </when>
            </choose>
        </where>
        ORDER BY s.subject_sort_order ASC
    </select>

</mapper>
