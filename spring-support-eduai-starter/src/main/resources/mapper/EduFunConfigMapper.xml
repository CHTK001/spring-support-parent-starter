<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.eduai.mapper.EduFunConfigMapper">

    <!--
      列名以**线上库实际结构**为准：edu_fun_config 用的是 module_code / enabled /
      sort_order（无前缀），只有归属列带前缀（fun_config_owner_user_id）。
      此前这里写成 fun_config_module_code / fun_config_enabled / fun_config_sort_order，
      三个接口全部 500 —— 趣味中心因此一张卡片都不显示，模块配置页也打不开。
    -->

    <!-- 已启用的趣味模块配置列表：归属隔离 + 排序号升序 -->
    <select id="selectEnabledList" resultType="com.chua.starter.eduai.model.EduFunConfig">
        SELECT f.* FROM edu_fun_config f
        <where>
            f.enabled = 1
            <choose>
                <when test="scope.ownerPredicate != null">
                    AND (f.fun_config_owner_user_id IS NULL OR f.fun_config_owner_user_id = #{scope.ownerPredicate})
                </when>
            </choose>
        </where>
        ORDER BY f.sort_order ASC
    </select>

    <!-- 全部趣味模块配置列表（含停用）：归属隔离 + 排序号升序 -->
    <select id="selectScopedList" resultType="com.chua.starter.eduai.model.EduFunConfig">
        SELECT f.* FROM edu_fun_config f
        <where>
            <choose>
                <when test="scope.ownerPredicate != null">
                    AND (f.fun_config_owner_user_id IS NULL OR f.fun_config_owner_user_id = #{scope.ownerPredicate})
                </when>
            </choose>
        </where>
        ORDER BY f.fun_config_grade_level ASC, f.sort_order ASC
    </select>

    <!-- 指定学段的模块清单（学生端首页用）：只取该学段自己配置的行，
         不并入 grade_level IS NULL 的通用行 —— 后者是管理端趣味中心的模块开关，
         混进来会把 INSECT/IDIOM_BANK 这类管理端模块漏给学生端 -->
    <select id="selectByLevel" resultType="com.chua.starter.eduai.model.EduFunConfig">
        SELECT f.* FROM edu_fun_config f
        <where>
            f.fun_config_grade_level = #{gradeLevel}
            AND f.enabled = 1
            <choose>
                <when test="scope.ownerPredicate != null">
                    AND (f.fun_config_owner_user_id IS NULL OR f.fun_config_owner_user_id = #{scope.ownerPredicate})
                </when>
            </choose>
        </where>
        ORDER BY f.sort_order ASC
    </select>

    <!-- 按模块编码查询配置：优先取通用行（grade_level IS NULL），
         再退回任意一行。这样管理端原有按 code 操作的接口保持不变 -->
    <select id="selectByModuleCode" resultType="com.chua.starter.eduai.model.EduFunConfig">
        SELECT f.* FROM edu_fun_config f
        <where>
            f.module_code = #{moduleCode}
            <choose>
                <when test="scope.ownerPredicate != null">
                    AND (f.fun_config_owner_user_id IS NULL OR f.fun_config_owner_user_id = #{scope.ownerPredicate})
                </when>
            </choose>
        </where>
        ORDER BY f.fun_config_grade_level IS NOT NULL ASC, f.config_id ASC
        LIMIT 1
    </select>

</mapper>
