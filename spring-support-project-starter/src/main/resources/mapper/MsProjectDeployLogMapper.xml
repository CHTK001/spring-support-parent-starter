<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.project.support.mapper.MsProjectDeployLogMapper">

    <!-- 删除指定时间之前创建的部署日志（保留期清理用），返回删除行数 -->
    <delete id="deleteByTimeBefore">
        DELETE FROM ms_project_deploy_log WHERE create_time &lt; #{beforeTime}
    </delete>

</mapper>
