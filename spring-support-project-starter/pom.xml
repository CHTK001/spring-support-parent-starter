<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>
    <artifactId>spring-support-project-starter</artifactId>
    <description>
        发布项目管理模块：提供部署项目台账（项目类型/目标服务器/部署目录/启停脚本）、
        升级策略配置（删除旧内容/覆盖模式/自动解压）、基于 SSH/SFTP 的部署、升级、
        启动/停止/重启与部署日志审计能力。作为内部 starter 库由宿主运行时装配。
    </description>

    <dependencies>
        <!-- 服务器资产模块：复用 SSH 客户端工厂、连接池、主机凭据解析与主机台账 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-server-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 实时推送（可选 bean）：plugin.socket.enable=true 时注入 SocketSessionTemplate，
             部署/回滚进度广播；未启用 socket 的宿主不受影响（ObjectProvider 可选注入） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- AI 脚本生成不在此模块引入 spring-support-ai-starter（其打包产物为 fat-jar 不可作普通依赖）；
             ProjectAiScriptService 通过运行时反射查找 ChatClientRegistry bean，宿主装配 AI starter 时
             /ai-gen-script 自动可用，未装配时降级返回提示，不影响部署/守护主流程 -->

        <!-- 工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- SSH/SFTP 客户端（守护探测与部署执行直接引用 SshClient 类型，
             经 spring-support-server-starter 传递依赖在部分构建链上缺失，显式声明） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 作为内部 starter 库被其它模块依赖：禁用 fat-jar repackage，保留原始 jar 结构 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
