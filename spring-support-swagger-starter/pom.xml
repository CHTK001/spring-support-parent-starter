<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
  </parent>
  <artifactId>spring-support-swagger-starter</artifactId>
  <description>Swagger模块</description>
  <dependencies>
    <!-- 共享契约（provided）：Knife4jConfiguration 依赖 ServiceInfoContributor / ServiceInfoRegistry；
         provided 避免与 common-starter 形成 Maven 环（各 scope 一律拒绝） -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Knife4j（OpenAPI3）：文档 UI 与 springdoc 增强的唯一运行时来源，宿主经本 starter 获得 -->
    <dependency>
      <groupId>com.github.xiaoymin</groupId>
      <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
    </dependency>
    <!--        <dependency>-->
    <!--            <groupId>org.springdoc</groupId>-->
    <!--            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>-->
    <!--            -->
    <!--        </dependency>-->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <!-- Swagger 2.x 注解（io.swagger.annotations.*）与 3.x 注解一并由本模块统一提供：
         业务模块只依赖本 starter，不再各自声明 swagger-annotations -->
    <dependency>
      <groupId>io.swagger</groupId>
      <artifactId>swagger-annotations</artifactId>
    </dependency>
    <!-- Actuator 契约：文档聚合与健康信息暴露所需的端点类型 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
    </dependency>
    <!-- Actuator 自动配置：端点装配的条件与属性来源 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator-autoconfigure</artifactId>
    </dependency>
    <!-- Boot 4.x 模块：WebMvcEndpointHandlerMapping 从 actuator 拆分到 spring-boot-webmvc -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc</artifactId>
    </dependency>
  </dependencies>
</project>