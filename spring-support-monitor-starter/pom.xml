<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>
    <artifactId>spring-support-monitor-starter</artifactId>
    <description>
        服务器与中间件监控模块：提供资产主数据、采集任务、指标时序、解析规则、Guacamole
        网关、Redis Key 增删查改、AI 性能分析等能力；通过 SPI 接入多种采集与数据源。
    </description>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <!-- 服务器台账（资产联动 server-hosts 查询） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-server-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文件服务器插件(可选): file-storage ServerFilter 使用, 使 HTTP 服务器可挂 FileStorageServerFilter 变文件服务器。
             仅需要其中的 ServerFilter/Setting/LocalFileStorage 类; 其 web 分片上传自动配置 FileSystemAutoConfiguration
             引用的 Bean 在 monitor 未装配, 已在 application.yml 通过 spring.autoconfigure.exclude 排除 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-filesystem-starter</artifactId>
        </dependency>

        <!-- 缓存 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-cache-starter</artifactId>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-metrics-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-prometheus-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 时序存储：InfluxDB 引擎(SPI=influxdb)，用于指标明细长期存储与曲线查询 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-influxdb-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- TShark 网络抓包 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-tshark-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- MySQL 驱动（spring-boot:run 使用 MySQL profile 时需要） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>com.chua.starter.monitor.support.MonitorApplication</mainClass>
                        <includeSystemScope>true</includeSystemScope>
                    </configuration>
                </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
