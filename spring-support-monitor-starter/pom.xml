<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>
    <artifactId>spring-support-monitor-starter</artifactId>
    <description>
        服务器与中间件监控模块：提供资产主数据、采集任务、指标时序、解析规则、Guacamole
        网关、Redis Key 增删查改、AI 性能分析等能力；通过 SPI 接入多种采集与数据源。
    </description>

    <properties>
        <!-- 本模块既独立启动也被宿主当库依赖：默认跳过 fat-jar repackage，保证库坐标下是薄 jar；
             需要可执行包时构建传 -Dspring-boot.repackage.skip=false，产物为 *-exec.jar，不替换主构件 -->
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
        <!-- 网页解析（HTTP-HTML 数据源）；与 spring-support-ai-starter 保持同版本，避免同进程内两份 -->
        <jsoup.version>1.23.2</jsoup.version>
    </properties>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <!-- 服务器台账（资产联动 server-hosts 查询） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-server-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 任务调度：发布管理的定时发布 / Git 定时轮询依赖 job-starter。
             server-starter 中该依赖为 optional，应用侧必须显式引入才会装配调度能力。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-job-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 端口映射：ngrok / Cloudflare Tunnel 两个独立模块，经 AutoConfiguration.imports
             自动装配 /ms/tunnel/ngrok 与 /ms/tunnel/cloudflared（含 SSE 实时状态 /stream）。
             映射配置持久化到本地文件目录（plugin.*.store-dir），不依赖数据库；
             运行时默认 auto-start=false，由页面按需启停，避免监控进程启动即暴露公网端口。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ngrok-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-cloudflared-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Docker 独立模块（容器/镜像/网络/卷/镜像库/模板），
             经 AutoConfiguration.imports 自动装配 /ms/server/docker 接口 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-docker-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- CDP 调试中心：headless Chromium + CDP 代理（/ms/cdp REST + /ws/cdp WebSocket，
             经 AutoConfiguration.imports 自动装配 com.chua.starter.cdp.config.CdpAutoConfiguration） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-cdp-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 数据源中心（台账/连接/跨方言），独立模块，供监控与采集系统共享 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-hub-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 设备模块：/api/device/** 的唯一实现方。device-starter 本身是纯库（无启动类），
             必须由应用显式依赖，其 DeviceAutoConfiguration 才会经 AutoConfiguration.imports 生效。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-device-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 网页解析：数据同步的 HTTP-HTML 源按 CSS 选择器抓表格行（MonitorHttpRowsSupport）。
             版本与 spring-support-ai-starter 保持一致；此前只由它传递进来，本模块直接 import 故显式声明 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- 数据访问 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文件服务器插件(可选): file-storage ServerFilter 使用, 使 HTTP 服务器可挂 FileStorageServerFilter 变文件服务器。
             仅需要其中的 ServerFilter/Setting/LocalFileStorage 类; 其 web 分片上传自动配置 FileSystemAutoConfiguration
             引用的 Bean 在 monitor 未装配, 已在 application.yml 通过 spring.autoconfigure.exclude 排除 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-filesystem-starter</artifactId>
        </dependency>

        <!-- 服务发现（可选）：为「服务管理」的 service-discovery 插件提供独立查询接口
             （/ms/monitor/discovery）。声明为 optional，不向下游强制传递；
             缺失时接口降级为「未启用发现服务」提示，不影响其它功能 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-discovery-starter</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 上报客户端（report-client）注册服务端：接收 sync/client/register 与 monitor/app/report，
             为「节点管理 → 在线节点」与 /ms/monitor/discovery 提供在线节点数据。
             不设为 optional：部署端需要该服务端实际接收注册，否则节点列表恒为空 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-sync-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 缓存 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-cache-starter</artifactId>
        </dependency>

        <!-- AI 分析（ChatClient bean，用于主机指标/告警/Redis 的智能分析） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 系统管理 API（pages/system 的后端接口提供者）：
             /v2/user、/v2/third/login、/v2/captcha、/v2/sms、/v2/cache、/v2/announcement、
             /manage/*、/monitor/* 等全部由 spring-api-support-common-system-starter 提供；
             monitor 应用是 pages/system 的宿主，必须显式引入。
             传递依赖：common-service-starter + common-entity-starter（实体/建表
             V1.0__init_*.sql 由 datasource-starter 的 FlywayLike 机制在 report 库执行）。
             artifact 由 spring-support-api-starter 构建，不在本 reactor 模块树内。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-api-support-common-system-starter</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-metrics-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-redis-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-prometheus-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 实时推送：plugin.socket.enable=true 时注入 SocketSessionTemplate，
             tshark 抓包逐包广播；netty-socketio 服务由 monitor 独立启动，需 socket-io-starter SPI 实现 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-io-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 消息队列：socket 推送经 queue 解耦（MonitorPushService → queue → SocketQueueBridge → 前端），
             单机用 plugin.queue.type=local；多实例用 kafka/rabbitmq/mqtt 实现广播 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-queue-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 时序存储：InfluxDB 引擎(SPI=influxdb)，用于指标明细长期存储与曲线查询 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-influxdb-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- ZooKeeper 管理页：复用本仓 Curator 封装，不额外引入第三方注册中心客户端 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-zookeeper-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- Elasticsearch 管理页：中间件 SPI=elasticsearch，走低频只读的 _cat/_search 读接口。
             该模块同时注册 Engine/Dialect（JDBC 式接入），一并带来 co.elastic.clients 客户端，
             属重型依赖——若某宿主不想承担，去掉这条即可，SPI 契约下页面自动退回「功能未开放」。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-elasticsearch-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 数据同步：复用本仓 datasync 引擎的**数据面**（JDBC 源 + 字段映射转换 + Sink 契约）。
             刻意不引 spring-support-datasync-starter：它带 ssh/osgi/datalake 重依赖，且在 spring 层
             只做「映射加载」不提供接口；引擎的 Scheduler/Executor 走 Chronicle 且有「同 topic 只订阅
             一次」语义（改任务后仍会写旧 Sink），控制台改用 Spring 定时器驱动，理由见
             SyncTaskServiceImpl 类注释。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasync-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- MySQL 内核 SPI 实现（UserManager / PermissionManager / ProcessManager / SlowQueryManager）。
             数据源中心的「用户管理 / 显示进程 / 慢查询」三项能力，判据就是
             DbSpiCapabilityController.spi(XxxManager.class, "mysql", id) != null —— 走的是
             META-INF/extensions 里的 SPI 注册，而不是 mysql-connector-j 驱动本身。
             只引 mysql-connector-j 时三个能力会恒为 false，菜单入口全部消失；
             这里补上实现模块，让 mysql=... 的注册文件进到 classpath。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-mysql-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 引擎的源/Sink 以响应式 Flux 为数据面，契约在本模块直接使用 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Curator 5.9.0 传递依赖 3.9.3，本仓已备 3.9.4 补丁版，就近覆盖以免重复拉取 -->
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
            <version>3.9.6</version>
        </dependency>

        <!-- TShark 网络抓包 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-tshark-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- MySQL 驱动（spring-boot:run 使用 MySQL profile 时需要） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL 驱动：CSV 快速导入（快速模式）的 COPY ... FROM STDIN 直灌实现
             （PostgresqlCsvLoader 使用 pgjdbc 的 CopyManager，编译期直接引用驱动专属 API，
             故用 compile 作用域而非 runtime），版本由 spring-boot BOM 管理 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- OSHI 本地硬件/操作系统信息采集 -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>6.6.5</version>
        </dependency>

        <!-- JNA：oshi-core 的原生层依赖，必须 >= 5.16。
             显式声明是为了压过 spring-support-device-starter 传递进来的 5.14.0
             （本机 .m2 里的 device-starter 产物是 2026-09-27 的旧版本，它的 pom 仍写 5.14.0；
             源码 pom 已改成 5.19.1，只是没重新 install）。5.14 缺
             oshi.jna.platform.windows.Kernel32#IsProcessorFeaturePresent(int)，
             OSHI 初始化直接抛错 → 整个 OSHI 采集静默降级成 JVM 系统属性，
             CPU 名称 / 核数 / 内存 / 显卡 / 磁盘 / 网卡全部为空，只留一行 WARN。
             这里就近声明（nearest-wins）确保 monitor 运行时用的是 5.19.1。 -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.1</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <!-- 仅测试作用域。规约要求测试必须真实，禁止引入 mockito/easymock/jmock（任何作用域） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 作为内部 starter 库被其它模块依赖：禁用 fat-jar repackage，保留原始 jar 结构，避免下游模块无法解析 BOOT-INF/classes 之外的类 -->
                    <skip>${spring-boot.repackage.skip}</skip>
                    <!-- 可执行包另挂 exec 分类符，绝不替换主构件；历史上 repackage 覆盖主构件曾让库坐标变成 1.2GB fat jar -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
            <!--
              repackage 只把 META-INF/services 搬进 BOOT-INF/classes，
              而 META-INF/spring 与 META-INF/extensions 会被留在 exec jar 的根目录。
              根 META-INF 不在应用 classpath（Spring-Boot-Classes=BOOT-INF/classes/）上，
              于是 META-INF/spring/...AutoConfiguration.imports 永远不会被读取，
              MonitorAutoConfiguration（@EnableConfigurationProperties + 建表初始化器）随之失效。
              这里在 repackage 之后把它们复制到 BOOT-INF/classes 下，使 java -jar 与 exploded 行为一致。
              仅作用于 *-exec.jar；薄 jar 保持标准库结构（META-INF 在根）不变。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>relocate-boot-classes-meta-inf</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- 与 repackage 同进同退：默认薄 jar 构建不执行，避免无 exec 产物时误报 -->
                            <skip>${spring-boot.repackage.skip}</skip>
                            <target>
                                <property name="exec.jar" value="${project.build.directory}/${project.build.finalName}-exec.jar"/>
                                <tempfile property="work.dir" destdir="${java.io.tmpdir}" prefix="repackage-meta-"/>
                                <unzip src="${exec.jar}" dest="${work.dir}">
                                    <patternset>
                                        <include name="META-INF/spring/**"/>
                                        <include name="META-INF/extensions/**"/>
                                    </patternset>
                                </unzip>
                                <copy todir="${work.dir}/BOOT-INF/classes/META-INF" failonerror="false">
                                    <fileset dir="${work.dir}/META-INF">
                                        <include name="spring/**"/>
                                        <include name="extensions/**"/>
                                    </fileset>
                                </copy>
                                <!-- keepcompression 保留原 jar 中已有条目的压缩方式；薄 jar 中的 nested jar 是 STORED
                                     的（loader 要求不解压），必须继续 STORED，否则重新 deflate 后 loader 拒绝加载 -->
                                <zip destfile="${exec.jar}" update="true" keepcompression="true">
                                    <zipfileset dir="${work.dir}/BOOT-INF/classes/META-INF" prefix="BOOT-INF/classes/META-INF">
                                        <include name="spring/**"/>
                                        <include name="extensions/**"/>
                                    </zipfileset>
                                </zip>
                                <delete dir="${work.dir}" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

