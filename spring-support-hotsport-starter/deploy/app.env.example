# =============================================================================
# app.env.example - hotsport 部署参数模板（复制为 config/app.env 后修改）
#
# config/app.env 不入仓库（里面有对外端口等本机相关取值）。
# start.sh 会在启动前 source 它，因此这里的变量优先级高于脚本内置默认值。
#
#   cp config/app.env.example config/app.env
#   chmod 600 config/app.env
#   vi config/app.env
# =============================================================================

# ---------------------------------------------------------------- 端口
# 与宿主应用同机部署时，务必避开宿主自己的端口
PORT=18086

# ---------------------------------------------------------------- JVM
# APM 观测端通常与宿主同机，堆不要开大，别把宿主挤掉。
JAVA_OPTS="-Xms256m -Xmx1024m -Dfile.encoding=UTF-8"

# ---------------------------------------------------------------- 启动参数
# APM 观测端不需要外部数据库：application.yml 里的 H2 兜底即可。
# 需要把 APM 数据落到真实数据库（MySQL/MariaDB）时，用 type=mysql + JDBC 连接信息：
#   --plugin.hotsport.apm.storage.type=mysql
#   --plugin.hotsport.apm.storage.url=jdbc:mysql://127.0.0.1:3306/hotsport
#   --plugin.hotsport.apm.storage.username=hotsport
#   --plugin.hotsport.apm.storage.password=<password>
# 要求：mysql-connector-j 已放入 lib/（starter 中该依赖是 optional，需手动拷贝）。
APP_ARGS=""

# ---------------------------------------------------------------- 探活
# 本应用没有 actuator，用 APM 自身的统计接口探活
HEALTH_PATH=/api/apm/stats

# ---------------------------------------------------------------- 启动超时
# 实测冷启动约 1.7s，留足窗口以防首次解压/类加载变慢
START_TIMEOUT=120
