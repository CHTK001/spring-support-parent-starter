  <dependencies>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <!-- jakarta.servlet-api 在 common-starter 里是 provided（不传递），本 starter 的 Filter 需要显式声明 -->
