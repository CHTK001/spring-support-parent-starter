<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <artifactId>spring-support-osgi-starter</artifactId>
    <description>OSGi Spring Boot Starter：集成 Felix OSGi 框架、Gogo/SSHD 远程管理，暴露实时 ObjectContext</description>

    <dependencies>
        <!-- 本模块只依赖 logger（ServiceInfoContributor 契约）与 utils 层，不依赖 common：
             依赖方向为 common -> osgi（SPI 注册门面），osgi 不得反向依赖 common -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-logger-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-osgi-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 实时日志（可选，编译期需要 SocketSessionTemplate 类型；运行时按 @ConditionalOnClass 装配）。
             宿主启用 socket 时，把插件操作日志广播到全局 socket 连接；
             未引入时由 OsgiRealtimeConfiguration 的空实现兜底，模块仍可独立运行 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 源码扩展点装配的真实行为测试（OsgiSourceConfigurationRealTest）。
             本模块此前没有任何 src/test，junit 需显式引入。 -->
    </dependencies>
</project>
