<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <artifactId>spring-support-osgi-starter</artifactId>
    <description>OSGi Spring Boot Starter：集成 Felix OSGi 框架、Gogo/SSHD 远程管理，暴露实时 ObjectContext</description>

    <dependencies>
        <!-- 本模块只依赖 logger（ServiceInfoContributor 契约）与 utils 层，不依赖 common：
             依赖方向为 common -> osgi（SPI 注册门面），osgi 不得反向依赖 common -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-logger-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-osgi-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <!-- OSGi 插件契约（BundleApplication / OsgiLauncher 等）唯一定义处，
             插件侧也应依赖该零依赖契约模块（provided）而非本 starter -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-osgi-bundle-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 实时日志不依赖 socket：插件操作日志（OsgiLogEvent，契约在 logger-starter）
             经 Spring 事件发布，由 socket-starter 侧的 SocketOsgiLogBridge 监听广播。
             若本模块依赖 socket（哪怕 optional），common -> osgi -> socket -> common
             会构成 reactor 依赖环 -->

        <!-- 控制器单元测试（生命周期锁 / 启停超时 / 上传限额 / 批量端点 / jars 索引）。
             本模块此前没有 src/test，junit-jupiter 需显式引入；
             版本由父 pom 的 junit.jupiter.version 统一托管。 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
