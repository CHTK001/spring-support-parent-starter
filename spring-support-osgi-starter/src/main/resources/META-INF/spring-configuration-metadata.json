      "name": "plugin.osgi.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用 OSGi 集成（默认开启）。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties",
      "defaultValue": true
    },
    {
      "name": "plugin.osgi.storage",
      "type": "java.lang.String",
      "description": "Felix 框架持久化存储目录。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties",
      "defaultValue": "./osgi-cache"
    },
    {
      "name": "plugin.osgi.start-level",
      "type": "java.lang.Integer",
      "description": "Felix 框架初始启动级别。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties",
      "defaultValue": 4
    },
    {
      "name": "plugin.osgi.shell.enabled",
      "type": "java.lang.Boolean",
      "description": "是否启用远程管理（SSH 或 Telnet）。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties$Shell",
      "defaultValue": false
    },
    {
      "name": "plugin.osgi.shell.protocol",
      "type": "java.lang.String",
      "description": "远程管理协议：ssh（默认，端口 8122）或 telnet（端口 6666）。同一实例只启用一种。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties$Shell",
      "defaultValue": "ssh"
    },
    {
      "name": "plugin.osgi.shell.port",
