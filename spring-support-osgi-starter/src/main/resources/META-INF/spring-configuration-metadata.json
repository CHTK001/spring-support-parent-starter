      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties$Shell",
      "defaultValue": "127.0.0.1"
    },
    {
      "name": "plugin.osgi.shell.username",
      "type": "java.lang.String",
      "description": "认证用户名（SSH 模式）。",
      "sourceType": "com.chua.starter.osgi.properties.OsgiProperties$Shell",
      "defaultValue": ""
    },
    {
      "name": "plugin.osgi.shell.password",
      "type": "java.lang.String",
      "description": "认证密码（SSH 模式）。",
