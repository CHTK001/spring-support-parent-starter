<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chua.starter.job.support.store.JobMapper">

    <!-- 按分组查询有效任务编号列表 -->
    <select id="selectJobNosByGroup" resultType="java.lang.String">
        SELECT sys_job_no
        FROM sys_job
        WHERE sys_job_group = #{group}
          AND sys_job_is_deleted = 0
    </select>

    <!-- 数据库当前时刻：调度判据统一以库时钟为准（多机时钟漂移不进入判据）。
         刻意只用标准 CURRENT_TIMESTAMP、不含任何库专用时间函数，由调用方在 Java 侧换算毫秒，
         使该语句在 MySQL 与 H2 上都能执行。 -->
    <select id="selectDbNow" resultType="java.sql.Timestamp">
        SELECT CURRENT_TIMESTAMP
    </select>

</mapper>
