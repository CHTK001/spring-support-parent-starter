<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <artifactId>spring-support-job-starter</artifactId>
    <description>任务模块: @Job + Scheduler/Executor/SINGLE 三模式, sync 下拆 scheduler/executor</description>

    <dependencies>
        <!-- 共享契约：ReturnResult、异常与鉴权工具 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- Redis 选主实现（可选依赖）：不引入时该扩展取不到，自动回落数据库实现，
             因此不会把"必须装 Redis"变成任何使用方的启动前提。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 持久层（optional）：作业与任务记录的 MyBatis-Plus 映射，宿主已引入时生效 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- RSocket 传输：分布式作业调度与执行节点间通信 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-rsocket-starter</artifactId>
        </dependency>


        


        <!-- 任务治理 HTTP 接口 (/v2/job/**) 所需, 可选依赖: 非 Web 应用不引入也不会装配 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 接口文档注解 - 仅 API 文档标记；本模块自带启动类（Job*Application），
             需 compile 让注解与 knife4j 进可执行 jar -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>


        
             
             

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <arg>-Xmaxerrs</arg>
                        <arg>9999</arg>
                        <arg>-Xmaxwarns</arg>
                        <arg>9999</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 作为内部 starter 库被其它模块依赖：禁用 fat-jar repackage，保留原始 jar 结构，避免下游模块无法解析 BOOT-INF/classes 之外的类 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
</build>
</project>
