<?xml version="1.0" encoding="UTF-8"?>
<!--
    文件存储模块 - spring-support-filesystem-starter

    该模块提供统一的文件存储抽象层，支持多种存储后端：
    - 本地文件系统
    - MinIO / S3 兼容对象存储（依赖 utils-support-minio-starter）
    - 阿里云 OSS / 腾讯云 COS / 华为云 OBS（依赖对应 starter）
    - FTP / SFTP

    特性：
    - 统一的 FileStorageTemplate API
    - 支持 SPI 扩展机制 (@Spi 注解 + META-INF/extensions/<接口名> 注册)
    - 支持多存储后端 + 多 Bucket 路由
    - 支持文件上传、下载、删除、列表等操作
    - 支持分片上传 (FileChunkUploadController)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>

    </parent>

    <artifactId>spring-support-filesystem-starter</artifactId>
    <name>Spring Support FileSystem Starter - 文件存储模块</name>
    <description>统一文件存储抽象层，支持 MinIO、OSS、COS 等多种存储后端</description>

    <dependencies>
        <!-- Lombok (编译期, 不会打入运行时 JAR; version 由父 pom dependencyManagement 提供) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 基础工具包，包含 FileStorage 接口 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- Spring Web（提供 @RestController 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Common -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- MyBatis Plus（实体、Mapper、Service） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- Swagger API文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 继承父 pom 的 maven-compiler-plugin (3.13.0 + lombok annotation processor + add opens 配置)
         子模块切勿重复声明 compiler plugin, 否则覆盖父 pom 的 fork / add-opens / lombok 配置,
         导致 Lombok 在 Java 25 上 annotation processor 不工作, 编译报 "字段是 private 访问控制"。 -->

</project>