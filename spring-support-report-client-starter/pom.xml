<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.42</version>
  </parent>
  <artifactId>spring-support-report-client-starter</artifactId>
  <description>上报信息客户端模块</description>
  <properties>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-ssh-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-oauth-client-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-job-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-oshi-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-groovy-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-swagger-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-network-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-discovery-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-core</artifactId>
    </dependency>
    <!-- SyncProtocol 支持 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-sync-starter</artifactId>
    </dependency>
    <!-- Jakarta Servlet API -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-common-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>utils-support-spring-starter</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <useIncrementalCompilation>true</useIncrementalCompilation>
          <compilerArgs>
            <arg>--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
            <arg>--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
            <arg>--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
            <arg>--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
            <arg>-parameters</arg>
            <arg>-J--enable-native-access=ALL-UNNAMED</arg>
            <arg>--release=25</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>

                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>

          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>