<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support Device Starter - 设备管理模块

    提供海康、大华等主流安防厂商设备的统一接入管理能力，
    包含设备接入、通道管理、视频、云台、门禁、事件、地图位置、
    离线检测定时调度与 Excel 导出等功能。

    @author CH
    @since 4.0.0.42
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父项目配置 -->
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <!-- 项目基本信息 -->
    <artifactId>spring-support-device-starter</artifactId>
    <description>设备管理模块，支持海康/大华等多平台接入与视频、云台、门禁、事件、地图、离线检测能力</description>

    <!-- 依赖配置 -->
    <dependencies>
        <!-- Web 支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis Plus (Spring Boot 4) -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- Spring Support MyBatis(PageResult / 分页拦截器) -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- Spring Support Common -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- Redis 时序引擎（plugin.device.timeseries.engine=redis）编译期类型。
             optional=true：宿主持有 spring-data-redis 时才装配 Redis 引擎，
             未引入时模块照常启动，只是该引擎不可用（页面会如实提示原因） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Swagger 注解（DeviceGroupController 文档注解） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 实时推送（可选，编译期需要 SocketSessionTemplate 类型；运行时按 @ConditionalOnClass 装配）。
             宿主启用 socket 时，把设备事件广播到 SSE/WebSocket；
             未引入时由 DeviceRealtimeConfiguration 的空实现兜底，模块仍可独立运行 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-socket-starter</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- OAuth 客户端注解（@TokenForIgnore）：设备模块自己声明免登录态的 webhook 入站端点，
             不写宿主 yaml 白名单。optional=true：未引入 oauth-client 的宿主不会被强加依赖，
             注解在运行时不存在时静默失效，不影响模块编译与启动 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 海康综合安防平台官方 SDK：artemis 网关签名（x-ca-*）由 SDK 内部完成。
             官方只在 Maven Central 发布了这一个安防类 SDK；云曜/云眸/大华/乐橙均无官方 Java SDK，
             由 provider.sdk 包内的统一门面按官方 OpenAPI 实现 -->
        <dependency>
            <groupId>com.hikvision.ga</groupId>
            <artifactId>artemis-http-client</artifactId>
            <version>1.1.3</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Excel 导出 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- JNA（海康/大华 SDK 本地调用） -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.19.1</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.19.1</version>
        </dependency>

        <!-- 测试依赖 -->
        
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/test/resources</directory>
            </resource>
        </resources>
    </build>
</project>