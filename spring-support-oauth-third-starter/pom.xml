<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.chua</groupId>
    <artifactId>spring-support-parent-starter</artifactId>
    <version>4.0.0.51</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>spring-support-oauth-third-starter</artifactId>
  <name>Spring Support OAuth Third Starter</name>
  <description>统一认证 SSO 模块 - 提供第三方登录、三方账号绑定、回调编排与换票等可复用能力；
    宿主实现 SsoLoginBridge 即可接入，无需引入整套系统业务
    </description>
  <dependencies>
    <!-- 共享契约：ReturnResult、鉴权与用户上下文的公共类型 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-common-starter</artifactId>
    </dependency>
    <!-- OIDC 协议实现：标准 OpenID Connect 授权码流程与 ID Token 校验（版本待根 POM 托管） -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>oauth2-oidc-sdk</artifactId>
    </dependency>
    <!-- JSON 编解码：第三方平台返回报文与用户信息体的解析 -->
    <dependency>
      <groupId>com.alibaba.fastjson2</groupId>
      <artifactId>fastjson2</artifactId>
    </dependency>
    <!-- 本仓库 oauth 基础模块：协议抽象、令牌签发与安全身份结果的复用契约 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-oauth-starter</artifactId>
    </dependency>
    <!-- 持久层：三方账号绑定关系表的 MyBatis-Plus 映射契约 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-mybatis-starter</artifactId>
    </dependency>
    <!-- OpenAPI 注解：本模块控制器与 VO 的 @Tag/@Operation/@Schema 描述 -->
    <dependency>
      <groupId>com.chua</groupId>
      <artifactId>spring-support-swagger-starter</artifactId>
    </dependency>
    <!-- Web 契约（provided）：回调控制器依赖的 MVC 类型，容器由宿主提供 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Web MVC（provided）：@RestController 与参数解析的编译期契约 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
