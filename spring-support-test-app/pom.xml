<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>

    <artifactId>spring-support-test-app</artifactId>
    <name>spring-support-test-app</name>
    <description>真实 Spring Boot 集成测试应用：权限（接口/按钮/数据）、api 版本/灰度、数据源合并/分片</description>

    <dependencies>
        <!-- web：MockMvc 接口测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 接口/按钮权限：Permission 注解 + PermissionInterceptor 自动装配 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-oauth-client-starter</artifactId>
        </dependency>

        <!-- 数据权限：@DataScope + MyBatis-Plus 拦截器自动装配 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- api 版本/灰度注解与拦截器 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>

        <!-- 多数据源/@DS、数据源合并与分片 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>

        <!-- 数据源分片（ShardingSphere 5.x 集成）：datasource starter 的可选依赖，显式引入以激活
             ShardingAutoConfiguration（@ConditionalOnClass(ShardingV5Conversion)） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-shardingv5-starter</artifactId>
        </dependency>

        <!-- 分片引擎运行期必需：shardingv5 starter 对 utils-support-datasource-starter 为 provided（不传递），
             缺失时 DataSourceConversion 链接失败 -> @ConditionalOnClass(ShardingV5Conversion) 退避（测试跳过） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasource-starter</artifactId>
        </dependency>

        <!-- UEBA 分析引擎自动装配验证 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ueba-starter</artifactId>
        </dependency>

        <!-- 管理控制台：FTL 页面鉴权 + @ApiFeature/@ApiGray/键值覆盖 SQLite 持久化 + 指纹重置 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-console-starter</artifactId>
        </dependency>

        <!-- OSGi（Apache Felix + Gogo SSH shell）：真实测试 bundle 安装/卸载（ssh shell 模式） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-osgi-starter</artifactId>
        </dependency>
        <!-- jsch：SSH shell 模式测试客户端（osgi-starter 内为 test 作用域不传递，此处显式声明） -->
        <dependency>
            <groupId>com.jcraft</groupId>
            <artifactId>jsch</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试：spring-boot-starter-test + h2 + webmvc-test（Boot 4 中 MockMvc 测试支持
             模块化为独立构件 spring-boot-webmvc-test） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
