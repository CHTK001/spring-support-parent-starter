<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.42</version>
    </parent>
    <artifactId>spring-support-datasource-hub-starter</artifactId>
    <description>
        数据源中心模块：统一登记与管理被采集/被连接的数据源（JDBC/Redis/InfluxDB/Neo4j/Nacos/ZooKeeper/Nginx 等），
        提供数据源台账 CRUD、连通性探测与可复用的 JDBC 连接（空闲 TTL 缓存 + 跨方言元数据）。
        独立于监控模块，供监控、采集等系统共享。
    </description>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据访问：应用主数据源 + MyBatis-Plus -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具：ReturnResult / SqlName / ExpireValue -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- AI 文本生成 SQL（text2sql）：optional —— 只有宿主应用同时引入 ai-starter 时
             该能力才生效；未引入时 ObjectProvider 取不到实现，ai/status 端点如实上报
             「不可用」，前端据隐藏 text2sql 入口（不会因缺包而启动失败）。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SSH 隧道（高级配置）：复用 utils 层已有的 MINA SSHD 客户端，
             其 SshTunnel 已支持 LOCAL/REMOTE(-R 反向)/DYNAMIC(SOCKS5)，
             故本模块不再单独引入任何 SSH 第三方依赖 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>

        <!-- 数据库驱动（本地直跑/便携部署）：MySQL + H2 双驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文件库直连：H2 与 SQLite 驱动进运行时 classpath。
             不加的话文件库只能走上传 jar，而“新建文件库”本应开箱即用
             （版本由 Spring Boot BOM 管理，与 console-starter 的 sqlite-jdbc 写法一致）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- ZooKeeper 管理页：复用本仓 Curator 封装，不额外引入第三方注册中心客户端
             （坐标照抄 monitor-starter，用于 ZookeeperClient/ZookeeperManageServiceImpl） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-zookeeper-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- Curator 5.9.0 传递依赖 3.9.3，本仓已备 3.9.4 补丁版，就近覆盖以免重复拉取
             （坐标照抄 monitor-starter，用于 ZookeeperClient/ZookeeperManageServiceImpl） -->
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
            <version>3.9.6</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <!-- 仅测试作用域。规约要求测试必须真实，禁止引入 mockito/easymock/jmock（任何作用域） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>