<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>
    <artifactId>spring-support-datasource-hub-starter</artifactId>
    <description>
        数据源中心模块：统一登记与管理被采集/被连接的数据源（JDBC/Redis/InfluxDB/Neo4j/Nacos/ZooKeeper/Nginx 等），
        提供数据源台账 CRUD、连通性探测与可复用的 JDBC 连接（空闲 TTL 缓存 + 跨方言元数据）。
        独立于监控模块，供监控、采集等系统共享。
    </description>

    <dependencies>
        <!-- Spring 与基础 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 数据访问：应用主数据源 + MyBatis-Plus -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-datasource-starter</artifactId>
        </dependency>
        <!-- Calcite 联邦内核（数据源合并的编译前提）：datasource-starter 里声明为
             optional，传递不到本模块；合并功能是本模块的一等能力，故显式引入。
             未引时 CalciteMergeDataSourceFactory 编译不过，这属于「功能与依赖同进退」。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-calcite-starter</artifactId>
        </dependency>
        <!-- 中间件 SPI 契约：MiddlewareClientProvider / Capability / VO。
             宿主只认契约，不认任何具体中间件客户端 —— Kafka / InfluxDB / ZooKeeper
             等实现放在各自 utils-support-*-starter 里，按需引入或 OSGi 后装。
             （该模块编译期依赖干净：R2DBC/JDBC 驱动均为 test scope，jsqlparser 为 provided） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-datasource-starter</artifactId>
        </dependency>
        <!-- Kafka 管理能力（SPI 实现）：宿主只认契约，这一行决定「Kafka 功能是否开放」。
             去掉它（或改为 OSGi bundle 后装），Kafka 功能即变为「未开放」，
             而主依赖树里不会留下任何 kafka-clients 痕迹 —— 这正是拆分的意义。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-kafka-starter</artifactId>
        </dependency>
        <!-- 以下两个中间件管理能力同为 SPI 实现：装配方式与 Kafka 完全一致
             （引进来即开放功能，删掉即变为「功能未开放」），
             差别只在「默认带」还是「按需带」。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-influxdb-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-mybatis-starter</artifactId>
        </dependency>

        <!-- 文档 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-swagger-starter</artifactId>
        </dependency>

        <!-- 工具：ReturnResult / SqlName / ExpireValue -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- AI 文本生成 SQL（text2sql）：optional —— 只有宿主应用同时引入 ai-starter 时
             该能力才生效；未引入时 ObjectProvider 取不到实现，ai/status 端点如实上报
             「不可用」，前端据隐藏 text2sql 入口（不会因缺包而启动失败）。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-ai-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 数据库文档导出（/ms/monitor/db/document/export）：
             结构采集用 utils-support-datasource-starter 里的 DocumentParser("database")，
             markdown / html 渲染器在 utils-support-common-starter 里（已由上面两个依赖带入）。
             word / pdf 渲染器分属独立模块，且 pdf 还要求服务端装 wkhtmltopdf，
             故与 ai-starter 同口径声明为 optional：宿主不引就没有这两个导出格式，
             端点会如实 501、前端据 /document/formats 隐藏入口，而不是给一个点了就报错的按钮。 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-word-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-pdf-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SSH 隧道（高级配置）：复用 utils 层已有的 MINA SSHD 客户端，
             其 SshTunnel 已支持 LOCAL/REMOTE(-R 反向)/DYNAMIC(SOCKS5)，
             故本模块不再单独引入任何 SSH 第三方依赖 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-ssh-starter</artifactId>
        </dependency>

        <!-- 数据库驱动（本地直跑/便携部署）：MySQL + H2 双驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 文件库直连：H2 与 SQLite 驱动进运行时 classpath。
             不加的话文件库只能走上传 jar，而“新建文件库”本应开箱即用
             （版本由 Spring Boot BOM 管理，与 console-starter 的 sqlite-jdbc 写法一致）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- ClickHouse：走 JDBC（HTTP 协议，默认 8123），数据库管理台/打开表/设计表/查询
             与版本探测全部复用 jdbc 那一套，只需驱动在 classpath 上。
             用 all 分类器的 shaded 包：普通包会连带拉进自己的 Jackson/HttpClient，
             与应用的版本在同一 classpath 上打架，表现为别的功能莫名报 NoSuchMethod。 -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>0.11.0</version>
            <classifier>all</classifier>
            <scope>runtime</scope>
        </dependency>
        <!-- DuckDB：单文件嵌入式库（可直查 Parquet/CSV、ATTACH 其它库做联邦查询）。
             驱动内含各平台 native 库，故体积偏大（约 60MB），仅运行时需要 -->
        <dependency>
            <groupId>org.duckdb</groupId>
            <artifactId>duckdb_jdbc</artifactId>
            <version>1.5.6.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- ZooKeeper 管理页：复用本仓 Curator 封装，不额外引入第三方注册中心客户端
             （坐标照抄 monitor-starter，用于 ZookeeperClient/ZookeeperManageServiceImpl） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-zookeeper-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- Curator 5.9.0 传递依赖 3.9.3，本仓已备 3.9.4 补丁版，就近覆盖以免重复拉取
             （坐标照抄 monitor-starter，用于 ZookeeperClient/ZookeeperManageServiceImpl） -->
        <dependency>
            <groupId>org.apache.zookeeper</groupId>
            <artifactId>zookeeper</artifactId>
            <version>3.9.6</version>
        </dependency>

        <!-- MongoDB 管理页：官方同步驱动（MongoClient），与其它中间件一致按数据源行
             host/port/database/用户名/密码 建连，不引入 Spring Data MongoDB。
             版本口径：sync 自身声明 core/bson 同版本（5.13.0），但父链（Spring Boot 4.1
             的 mongodb-bom）把 org.mongodb:bson / mongodb-driver-core 钉在 5.8.1 ——
             混版会在运行期炸 NoClassDefFoundError（sync 5.13.0 要调 core 5.13 才有的
             AsyncClientExecutor），故三件套就近显式钉齐（写法参照上方 zookeeper 覆盖）。 -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-core</artifactId>
            <version>5.13.0</version>
        </dependency>
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>bson</artifactId>
            <version>5.13.0</version>
        </dependency>

        <!-- SkyWalking 控制台：查询走 OAP GraphQL（端口 12800），鉴权与地址
             按数据源行动态注入（见 SkywalkingManageServiceImpl） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-skywalking-starter</artifactId>
            <version>${utils.version}</version>
        </dependency>

        <!-- 日志 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <!-- 仅测试作用域。规约要求测试必须真实，禁止引入 mockito/easymock/jmock（任何作用域） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>