<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support CDP Starter - 基于 Chrome DevTools Protocol 的远程调试模块

    这是 Spring Support 框架的 CDP（Chrome DevTools Protocol）集成模块，
    通过本地启动 Chromium 并暴露 CDP JSON-RPC / WebSocket 接口，
    为前端 DevTools 面板（控制台 / 网络 / DOM / 调试 / 截图）提供双向数据通道。

    主要特性：
    1. CDP 网络代理：浏览器启动、目标管理、页面导航、元素定位；
    2. 控制台与网络事件：Console 日志、Network 请求/响应、运行时异常 实时推送；
    3. DOM 与截图：页面内容切换 / 元素获取；
    4. 内嵌 WebSocket 通道：完整支持 `pages/debug` 调试台（可选 SSE）。
    5. 使用 JDK 原生 WebSocket（java.net.http）连接浏览器，无第三方依赖。

    前提条件：
    在 JDK 上找到 Chromium / Chrome 可执行文件（通过 `spring.cdp.executable` 或
    系统环境变量 `CHUA_CHROME` / `CHROME_PATH` / `CHROME_BIN` 或 Playwright 缓存），
    方法见 {@link com.chua.common.support.browser.cdp.CdpBrowserEngine#locateBrowser(String)}。

    @author CH
    @since 4.0.0.51
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <!-- 模块基本信息 -->
    <artifactId>spring-support-cdp-starter</artifactId>
    <name>Spring Support CDP Starter</name>
    <description>基于 CDP 的浏览器调试代理模块，需要 Chromium / Chrome（JDK 可探测）</description>

    <properties>
        <!-- 作为内部 starter 库被宿主依赖：禁止 fat-jar repackage，保持标准库 jar 结构 -->
        <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
    </properties>

    <dependencies>
        <!-- 其他 starter 的统一事件 + 配置 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-common-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- utils generic: CDP 引擎 + WebSocket 封装 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- OpenAPI 注解（@Tag / @Operation / @Schema） -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>

        <!-- 返回包装 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>${spring-boot.repackage.skip}</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>25</source>
                    <target>25</target>
                    <fork>false</fork>
                    <release/>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
