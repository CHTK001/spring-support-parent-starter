<?xml version="1.0" encoding="UTF-8"?>
<!--
    Spring Support Common Starter - 通用功能模块

    这是Spring Support框架的核心通用模块，提供了企业级应用开发中常用的基础功能和工具类。
    包含以下主要功能：

    1. 统一响应处理 - 提供统一的API响应格式和异常处理
    2. 参数验证 - 集成Bean Validation进行参数校验
    3. 缓存支持 - 提供多级缓存和缓存管理功能
    4. 验证码生成 - 支持图形验证码生成和验证
    5. 文件存储 - 提供统一的文件存储接口
    6. 加密解密 - 支持数据加密和隐私保护
    7. 异步任务 - 提供异步任务执行和线程池管理
    8. 拦截器 - 提供通用的Web拦截器功能
    9. 工具类集成 - 集成各种常用工具类库

    @author CH
    @version 4.0.0.41
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父项目配置 -->
    <parent>
        <groupId>com.chua</groupId>
        <artifactId>spring-support-parent-starter</artifactId>
        <version>4.0.0.51</version>
    </parent>

    <!-- 项目基本信息 -->
    <artifactId>spring-support-common-starter</artifactId>
    <description>Spring Support框架通用功能模块，提供企业级应用开发的基础功能和工具类</description>

    <!-- 项目属性配置 -->
    <!-- 依赖配置 -->
    <dependencies>
        <!-- Apache Commons Lang3 - 提供反射等工具类 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Swagger 注解 - 用于 API 文档标记 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Commons Codec - 编解码工具 -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>


        <!-- 通用工具类库核心模块 - 提供 CommonConstant, Action, Version 等类 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-common-starter</artifactId>
        </dependency>

        <!-- 日志/链路/服务信息支撑类已迁至 spring-support-logger-starter（包名保持
             com.chua.starter.common.support.* 不变）。common 依赖 logger 并传递给
             全部使用方，外部 import 无需任何改动；方向：common -> logger，禁止反向 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-logger-starter</artifactId>
        </dependency>

        <!-- OSGi SPI 注册门面（P3）：方向 common -> osgi，osgi 不得反向依赖 common（R1/R2）。
             宿主依赖 common 即获得 OsgiServicePublisher 门面（Felix 未运行时 no-op）；
             Felix/SSH 等服务器设施由 plugin.osgi.server.enabled 门控（默认关），
             不会随 common 强加给宿主（R5） -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>spring-support-osgi-starter</artifactId>
        </dependency>

        <!-- Spring Boot JavaMail - 邮件发送支持（common 的 MailService 编译依赖）。
             标记 optional：不把 JavaMail 自动配置强加给全部宿主（R5），
             需要真实发信的宿主自行引入 spring-boot-starter-mail；
             MailService 本身由 @ConditionalOnBean(JavaMailSender) 门控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot参数验证 - 提供Bean Validation支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- Jackson JSR310时间处理 - 支持Java 8时间API的JSON序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Jackson JDK8模块 - 支持Optional等JDK8特性 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>

        <!-- HTTP客户端工具 - 提供HTTP请求功能 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-httpclient-starter</artifactId>
        </dependency>

        <!-- JDK 15+特性支持 - 提供新版本JDK特性的支持 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-jdk15on-starter</artifactId>
        </dependency>

        <!-- Google Guava工具库 - 提供Table等集合工具 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- Easy Captcha验证码生成器 - 提供图形验证码生成功能 -->
        <dependency>
            <groupId>com.github.whvcse</groupId>
            <artifactId>easy-captcha</artifactId>
        </dependency>

        <!-- 第三方验证码解析服务 - YesCaptcha/CaptchaRun 客户端 -->
        <dependency>
            <groupId>com.chua</groupId>
            <artifactId>utils-support-captcha-starter</artifactId>
        </dependency>

        <!-- Caffeine缓存 - 高性能的本地缓存库 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- XML 编解码：XML 报文与配置解析需要 Jackson 的 XML 后端 -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- Spring Boot缓存支持 - 提供缓存抽象和管理功能 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- WebFlux 契约（provided）：响应式 HTTP 与流的类型来源，容器由宿主提供 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
    <!-- Spring Boot 4.x 起独立为 spring-boot-webmvc，提供 WebMvcRegistrations 等 -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-webmvc</artifactId>
    </dependency>

    <!-- Spring JDBC - 仅编译期供 DataAccessExceptionAdvice（@ConditionalOnClass 隔离）使用；
         optional 不向消费方传递，无 JDBC 的宿主不再被带入 jdbc 全家桶 -->
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-jdbc</artifactId>
        <optional>true</optional>
    </dependency>

        <!-- OkHttp 客户端（provided）：部分 HTTP 探测与下载走 okhttp 实现，运行时由宿主提供 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson 数据绑定：JSON 编解码基础，本模块多处直接使用 ObjectMapper -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- IP2Proxy（provided）：IP 归属地与代理检测的可选实现，未装配时按无数据降级 -->
        <dependency>
            <groupId>com.ip2proxy</groupId>
            <artifactId>ip2proxy-java</artifactId>
            <scope>provided</scope>
        </dependency>

        

    

        
        
        
        
        

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED</arg>
                        <arg>-J--add-exports=jdk.unsupported/sun.misc=ALL-UNNAMED</arg>
                        <arg>-parameters</arg>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>

                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>

                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

